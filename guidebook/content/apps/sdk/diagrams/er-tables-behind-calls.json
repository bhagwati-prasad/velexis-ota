    {
      "id": "redis_keys",
      "label": "Redis keys its calls touch",
      "schema": "redis",
      "fields": [
        { "name": "apikey:<prefix>", "type": "cached key row, 60 s" },
        { "name": "apikey:used:<keyId>", "type": "last use, flushed by the platform worker" },
        { "name": "rl:<throttler>:<tracker>", "type": "rate-limit counters (sign-up 5/h per end-user IP)" },
        { "name": "staffsess:<familyId>", "type": "staff session family" },
        { "name": "ptk:<sha256>", "type": "portal token, 60 s, single use (smoke test writes it)" }
      ]
    }
