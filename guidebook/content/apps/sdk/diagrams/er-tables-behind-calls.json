{
  "id": "er-tables-behind-calls",
  "type": "er",
  "title": "What the SDK's calls change (through the OTA API)",
  "caption": "The SDK owns no table and stores nothing: every row below is written by the OTA API while it serves an SDK call. This is the subset to check after the smoke journey (storefront.get → flights.search → flights.price → checkout.create → auth.signUp → account.get / bookings.list → auth.signOut) and the staff sign-in. Platform tables are read-only for the OTA API (the smoke test writes the staff rows as velexis_migrator).",
  "entities": [
    {
      "id": "api_keys",
      "label": "platform.api_keys",
      "schema": "platform",
      "fields": [
        { "name": "id", "type": "text", "key": "pk" },
        { "name": "tenant_id", "type": "text", "key": "fk" },
        { "name": "prefix", "type": "text", "key": "uk" },
        { "name": "kind", "type": "text" },
        { "name": "environment", "type": "text" },
        { "name": "scopes", "type": "text[]" },
        { "name": "allowed_origins", "type": "text[]" },
        { "name": "revoked_at", "type": "timestamptz" },
        { "name": "last_used_at", "type": "timestamptz" }
      ]
    },
    {
      "id": "tenants",
      "label": "platform.tenants",
      "schema": "platform",
      "fields": [
