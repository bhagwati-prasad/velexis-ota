  "endpoints": [
    {
      "method": "POST",
      "path": "/v1/console/auth/sign-in",
      "operationId": "consoleSignIn",
      "purpose": "Called: SSO with the portal token"
    },
    {
      "method": "POST",
      "path": "/v1/console/auth/refresh",
      "operationId": "consoleRefreshSession",
      "purpose": "Called: rotate the staff session"
    },
    {
      "method": "POST",
      "path": "/v1/console/auth/sign-out",
      "operationId": "consoleSignOut",
      "purpose": "Called: sign out (scope current)"
    },
    {
      "method": "GET",
      "path": "/v1/console/auth/me",
      "operationId": "consoleGetMe",
      "purpose": "Called: once per request (profile, permissions, environments)"
    },
    {
      "method": "GET",
      "path": "/v1/console/bookings",
      "operationId": "consoleListBookings",
      "purpose": "Called: list, dashboard counts, customer bookings"
    },
    {
      "method": "GET",
      "path": "/v1/console/bookings/{bookingId}",
      "operationId": "consoleGetBooking",
      "purpose": "Called: detail (refresh=true for Sync)"
    },
    {
      "method": "PATCH",
      "path": "/v1/console/bookings/{bookingId}",
      "operationId": "consolePatchBooking",
      "purpose": "Called: travellers, contacts, remarks, agreement"
    },
    {
      "method": "POST",
      "path": "/v1/console/bookings/{bookingId}/issuance",
      "operationId": "consoleIssueBooking",
      "purpose": "Called: issue tickets"
    },
    {
      "method": "POST",
      "path": "/v1/console/bookings/{bookingId}/cancellation",
      "operationId": "consoleCancelBooking",
      "purpose": "Called: cancel with refund mode"
    },
    {
      "method": "POST",
      "path": "/v1/console/bookings/{bookingId}/review-closure",
      "operationId": "consoleCloseBookingReview",
      "purpose": "Called: close a reconciliation review"
    },
    {
      "method": "POST",
      "path": "/v1/console/bookings/{bookingId}/resync",
      "operationId": "consoleResyncBooking",
      "purpose": "Called: Resync from Amadeus"
    },
    {
      "method": "POST",
      "path": "/v1/console/bookings/{bookingId}/notes",
      "operationId": "consoleAddBookingNote",
      "purpose": "Called: add note"
    },
    {
      "method": "GET",
      "path": "/v1/console/bookings/{bookingId}/amadeus-order",
      "operationId": "consoleRetrieveFlightOrder",
      "purpose": "Called: Amadeus order tab"
    },
    {
      "method": "GET",
      "path": "/v1/console/bookings/by-record-locator",
      "operationId": "consoleFindBookingByRecordLocator",
      "purpose": "Called: PNR lookup"
    },
    {
      "method": "POST",
      "path": "/v1/console/bookings/imports",
      "operationId": "consoleImportBooking",
      "purpose": "Called: PNR import"
    },
    {
      "method": "GET",
      "path": "/v1/console/queues/{queueId}",
      "operationId": "consoleListQueue",
      "purpose": "Called: Read now"
    },
    {
      "method": "GET",
      "path": "/v1/console/queue-snapshots",
      "operationId": "consoleListQueueSnapshots",
      "purpose": "Called: queues, dashboard"
    },
    {
      "method": "GET",
      "path": "/v1/console/customers",
      "operationId": "consoleListCustomers",
