{
  "id": "ota-admin",
  "name": "OTA admin",
  "kind": "frontend",
  "product": "ota",
  "summary": "The back office of one OTA (Next.js 15, 127.0.0.1:3002), reached only by SSO from the portal: staff work bookings, import PNRs, read queues, quote fares, capture and refund payments, read customers and change markups, fees, storefront settings, pages and e-mail templates through the OTA API's console operations, called server side with the service key and the staff token.",
  "audience": [
    "OTA staff: owner, admin, agent, finance, viewer",
    "Velexis support and developers (bug hunting, supplier log)"
  ],
  "repoPath": "ota/admin",
  "package": "@velexis/ota-admin",
  "stack": [
    "Next.js 15.5 App Router (standalone output, middleware on the Node runtime)",
    "React 19",
    "TypeScript 5.6 strict",
    "Tailwind CSS 4 + shadcn/ui (Radix)",
    "@tanstack/react-table 8",
    "Zod 4.6.7 (server action validation only)",
    "@velexis/ota-sdk console namespace, server mode",
    "@velexis/config, @velexis/errors, @velexis/logger",
    "Vitest 4 + Testing Library (happy-dom)",
    "Playwright + axe e2e (tools/e2e, project ota-admin)"
  ],
  "local": {
    "url": "http://localhost:3002",
    "port": 3002,
    "command": "pnpm --filter @velexis/ota-admin dev",
    "notes": "Binds 127.0.0.1:3002. No sign-in page: open the console from the portal (http://localhost:3000, your own OTA; the demo OTA has no owner). Needs the OTA API on 127.0.0.1:4000 (and its worker), the portal, the platform API, PostgreSQL, Redis, Mailpit and the Amadeus stub. OTA_ADMIN_SERVICE_KEY must equal the backend's (sk_dev_… in .env.example, development only). Browse localhost, not 127.0.0.1, or /sso and sign-out refuse the Origin."
  },
  "production": {
    "host": "admin.ota.example.com"
  },
  "dependsOn": ["ota-api", "portal", "sdk", "packages"],
  "talksTo": [
    {
      "app": "ota-api",
      "how": "SDK console.* from server code only, on loopback (OTA_API_URL=http://127.0.0.1:4000): X-Api-Key service key, Bearer staff token, X-Velexis-Environment, X-Velexis-End-User-IP/-Agent, Idempotency-Key, If-Match"
    },
    {
      "app": "portal",
      "how": "Receives POST /sso from the portal's hand-off page (one-time portal token); redirects without a session to PUBLIC_PORTAL_URL/console?tenant=<id>; links the portal's OTA pages (team, API keys, domains, billing, go-live)"
    },
    {
      "app": "platform-api",
      "how": "Indirect: mints the portal token (ptk:<sha256> in Redis), owns memberships, the live flag and the billing notice that console.auth.me reports"
    },
    {
      "app": "storefront",
      "how": "Indirect: settings, rules, pages and templates change what it shows (5-minute browser copy); 'View on storefront' links"
    },
    {
      "app": "sdk",
      "how": "@velexis/ota-sdk createVelexisClient(...).console with secretKey, accessToken, sessionKind 'staff', environment"
    },
    {
      "app": "deploy",
      "how": "Caddy admin.ota.example.com → 127.0.0.1:3002; systemd unit velexis-ota-admin; deploy.sh polls /health/ready"
    },
    {
      "app": "packages",
      "how": "@velexis/config (env validation), @velexis/errors, @velexis/logger"
    }
  ],
  "data": [
    "tenant_<key>.bookings (+ booking_travelers, booking_contacts, booking_segments, booking_tickets, booking_remarks)",
    "tenant_<key>.booking_events",
    "tenant_<key>.payments, payment_events, refunds",
    "tenant_<key>.customers (read), saved_travelers, customer_sessions",
    "tenant_<key>.staff_actions",
    "tenant_<key>.idempotency_keys",
    "tenant_<key>.queue_snapshots",
    "tenant_<key>.supplier_requests (read)",
    "tenant_<key>.notifications (outbox, via the API)",
    "tenant_<key>.markup_rules, fee_rules",
    "tenant_<key>.storefront_settings, storefront_assets, storefront_pages",
    "tenant_<key>.notification_templates",
    "Redis (via the APIs): ptk:<sha256>, staffsess:<familyId>, staffdeny:acct|member|tenant:<id>, t:<tenantId>:<env>:sf:*, t:<tenantId>:<env>:pages:<locale>, rl:*",
    "Admin cookies: __Host-vx_staff_at, __Host-vx_staff_rt, __Host-vx_env, __Host-vx_tenant"
  ],
  "docs": [
    "ota/admin/README.md",
    "ota/admin/docs/routes.md",
    "ota/docs/flows/console-operations.md",
    "ota/docs/api-changes-console-and-internal.md",
    "ota/docs/scope.md",
    "ota/docs/runbooks/supplier-timeout-and-reconciliation.md",
    "tools/e2e/README.md",
    "docs/mvp/local-development.md"
  ],
  "adrs": [
    "ota/docs/adr/0018-ota-admin-consumes-the-sdk-server-side.md",
    "ota/docs/adr/0011-console-access-staff-sessions-and-environments.md",
    "ota/docs/adr/0009-caller-and-tenant-resolution.md",
    "platform/docs/adr/0007-portal-to-ota-admin-sso-token.md",
    "ota/docs/adr/0005-markup-and-fee-engine.md",
    "ota/docs/adr/0008-ticketing-policy.md",
    "ota/docs/adr/0012-storefront-settings-assets-and-pages.md",
    "ota/docs/adr/0013-notifications-and-booking-documents.md",
    "ota/docs/adr/0004-airline-card-data-handling.md",
    "docs/mvp/adr/0014-frontend-stack-nextjs-tailwind.md",
    "docs/mvp/adr/0008-identity-accounts-customers-sessions.md"
  ],
  "roles": [
    {
      "name": "Owner / admin",
      "can": "Everything: booking actions, allowUnpaid on issue, refunds, every settings write; LIVE on a live OTA"
    },
    {
      "name": "Agent",
      "can": "Bookings (patch, issue, cancel, notes, import, close review), PNR, queues, shopping, customers, supplier log, capture; settings read only; no refunds"
    },
    {
      "name": "Finance",
      "can": "Read bookings, customers, settings and the supplier log; capture and refund payments; no booking changes"
    },
    {
      "name": "Viewer",
      "can": "Read bookings, customers, payments and settings; no queues, shopping or supplier log; TEST only"
    },
    {
      "name": "Portal account without a membership of the OTA",
      "can": "Nothing: SSO refused (STAFF_MEMBERSHIP_INACTIVE); no console page opens without the staff cookies"
    }
  ],
  "screens": [
    {
      "route": "POST /sso",
      "title": "SSO hand-off (route handler)",
      "purpose": "Portal token → four __Host- cookies, 303 /bookings",
      "code": "ota/admin/src/app/sso/route.ts"
    },
    {
      "route": "GET /auth/refresh",
      "title": "Refresh fallback (route handler)",
      "purpose": "Refresh then 303 to a safe next",
      "code": "ota/admin/src/app/auth/refresh/route.ts"
    },
    {
      "route": "POST /auth/sign-out",
