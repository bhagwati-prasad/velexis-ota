      "operationId": "consolePreviewNotificationTemplate",
      "purpose": "Called: preview"
    },
    {
      "method": "POST",
      "path": "/v1/console/settings/notification-templates/{templateKey}/{channel}/{locale}/reset",
      "operationId": "consoleResetNotificationTemplate",
      "purpose": "Called: reset to default"
    }
  ],
  "tags": ["ota", "back-office", "console", "bff", "sso", "bookings", "pnr", "payments", "settings", "staff"]
}
