{
  "id": "seq-credential-submission",
  "type": "sequence",
  "title": "Own Amadeus credentials or Stripe API keys: submit and verify",
  "caption": "A submission waits encrypted while the worker verifies it, so a typo never breaks a working connection (PADR-0010).",
  "actors": [
    {
      "id": "fe",
      "label": "Portal server",
      "kind": "ui"
    },
    {
      "id": "api",
      "label": "Platform API",
      "kind": "api"
    },
    {
      "id": "pg",
      "label": "PostgreSQL",
      "kind": "db"
    },
    {
      "id": "r",
      "label": "Redis / BullMQ",
      "kind": "queue"
    },
    {
      "id": "pw",
      "label": "Platform worker",
      "kind": "worker"
    },
    {
      "id": "ext",
      "label": "Amadeus / Stripe",
      "kind": "external"
    }
  ],
  "steps": [
    {
      "from": "fe",
      "to": "api",
      "label": "PUT …/amadeus-connections/{env}/credentials or …/payment-connections/{env}/api-keys (step-up, feature own_amadeus / own_stripe)",
      "kind": "call"
    },
    {
      "from": "api",
      "to": "pg",
      "label": "advisory lock (tenant, kind, env); open submission → superseded, secrets erased",
      "kind": "call"
    },
    {
      "from": "api",
      "to": "pg",
      "label": "INSERT credential_submissions pending, secrets envelope-encrypted; audit",
      "kind": "call"
    },
    {
      "from": "api",
      "to": "r",
      "label": "after commit: platform-connections credentials.verify {submissionId}",
      "kind": "async"
    },
    {
      "from": "api",
      "to": "fe",
      "label": "202 {submission}",
      "kind": "return"
    },
    {
      "from": "r",
      "to": "pw",
      "label": "verification processor (concurrency 2)",
      "kind": "async"
    },
    {
      "from": "pw",
      "to": "pg",
      "label": "pending → verifying",
      "kind": "call"
    },
    {
      "from": "pw",
      "to": "ext",
      "label": "Amadeus token request / Stripe key check",
      "kind": "call"
    },
    {
      "from": "pw",
      "to": "pg",
      "label": "applied: connection switched (credential_source tenant / account_mode api_keys), office → releasing; or failed with error_code; secrets erased",
      "kind": "call"
    },
    {
      "from": "pw",
      "to": "r",
      "label": "vx:invalidate connection; e-mail connection.credentials_applied / _failed",
      "kind": "async"
    },
    {
      "from": "fe",
      "to": "api",
      "label": "GET /v1/tenants/{id}/credential-submissions/{submissionId} (poll)",
      "kind": "call"
    },
    {
      "from": "pw",
      "to": "pw",
      "label": "credentials.sweep every 5 min: re-queue stale pending, fail verifying unchanged for 1 h (PROVIDER_UNAVAILABLE)",
      "kind": "self"
    }
  ]
}
