{
  "id": "credential-submission-states",
  "type": "state",
  "title": "Credential submission",
  "caption": "`platform.credential_submissions.status`: own Amadeus credentials or Stripe API keys under verification. Secrets exist only while pending or verifying.",
  "states": [
    {
      "id": "start",
      "label": "",
      "kind": "initial"
    },
    {
      "id": "pending",
      "label": "pending",
      "kind": "normal"
    },
    {
      "id": "verifying",
      "label": "verifying",
      "kind": "normal"
    },
    {
      "id": "applied",
      "label": "applied",
      "kind": "final",
      "detail": "Connection switched."
    },
    {
      "id": "failed",
      "label": "failed",
      "kind": "error",
      "detail": "error_code, e.g. PROVIDER_UNAVAILABLE."
    },
    {
      "id": "superseded",
      "label": "superseded",
      "kind": "final",
      "detail": "A newer submission for the same slot."
    }
  ],
  "transitions": [
    {
      "from": "start",
      "to": "pending",
      "label": "submitAmadeusCredentials / submitStripeApiKeys"
    },
    {
      "from": "pending",
      "to": "verifying",
      "label": "credentials.verify"
    },
    {
      "from": "verifying",
      "to": "applied",
      "label": "provider accepts"
    },
    {
      "from": "verifying",
      "to": "failed",
      "label": "provider refuses / 1 h stale (credentials.sweep)"
    },
    {
      "from": "pending",
      "to": "superseded",
      "label": "new submission for the slot"
    },
    {
      "from": "verifying",
      "to": "superseded",
      "label": "new submission for the slot"
    }
  ]
}
