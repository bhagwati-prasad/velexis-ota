  "flows": [
    {
      "id": "search-and-book",
      "title": "Search and book",
      "summary": "A traveller searches, prices and pays on the hosted storefront; the OTA API calls Amadeus and Stripe, records the booking and the worker e-mails the documents.",
      "path": [
        {
          "from": "traveller",
          "to": "caddy",
          "label": "Open <key>.ota.example.com"
        },
        {
          "from": "caddy",
          "to": "storefront",
          "label": "Static HTML, JS and CSS"
        },
        {
          "from": "storefront",
          "to": "ota-api",
          "label": "storefront.get, flights.search via /api"
        },
        {
          "from": "ota-api",
          "to": "redis-cache",
          "label": "Host and tenant from the cache"
        },
        {
          "from": "ota-api",
          "to": "amadeus",
          "label": "Flight Offers Search, Upsell, Price"
        },
        {
          "from": "ota-api",
          "to": "pg-tenant",
          "label": "Searches, offers, priced offer, checkout"
        },
        {
          "from": "ota-api",
          "to": "stripe",
          "label": "PaymentIntent with manual capture"
        },
        {
          "from": "ota-api",
          "to": "amadeus",
          "label": "Flight Create Orders"
        },
        {
          "from": "ota-api",
          "to": "stripe",
          "label": "Capture the authorisation"
        },
        {
          "from": "ota-api",
          "to": "pg-tenant",
          "label": "Booking, payment, events, outbox"
        },
        {
          "from": "ota-api",
          "to": "redis-queues",
          "label": "Notification and document jobs"
        },
        {
          "from": "redis-queues",
          "to": "ota-worker",
          "label": "Worker picks the jobs"
        },
        {
          "from": "ota-worker",
          "to": "storage",
          "label": "Render the itinerary PDF"
        },
        {
          "from": "ota-worker",
          "to": "smtp",
          "label": "Confirmation e-mail with the itinerary"
        }
      ]
    },
    {
      "id": "ota-provisioning",
      "title": "OTA provisioning",
      "summary": "An owner creates an OTA; the platform records it and asks the OTA worker to create the tenant schema; the platform worker finishes the set-up and activates the OTA.",
      "path": [
        {
          "from": "owner",
          "to": "caddy",
          "label": "Create OTA in the portal"
        },
        {
          "from": "caddy",
          "to": "portal",
          "label": "Wizard submit"
        },
        {
          "from": "portal",
          "to": "platform-api",
          "label": "createTenant with Idempotency-Key"
        },
        {
          "from": "platform-api",
          "to": "pg-platform",
          "label": "Tenant, owner, subscription, domain, job"
        },
        {
          "from": "platform-api",
          "to": "redis-queues",
          "label": "tenant.provision (job_…-1)"
        },
        {
          "from": "redis-queues",
          "to": "ota-worker",
          "label": "OTA worker consumes ota-tenant-ops"
        },
        {
          "from": "ota-worker",
          "to": "pg-tenant",
          "label": "CREATE SCHEMA, migrations, grants, seeds"
        },
        {
          "from": "ota-worker",
          "to": "redis-queues",
          "label": "tenant.provisioned"
        },
        {
          "from": "redis-queues",
          "to": "platform-worker",
          "label": "Platform worker consumes the event"
        },
        {
          "from": "platform-worker",
          "to": "pg-platform",
          "label": "Office, payment connection, keys, active"
        },
        {
          "from": "platform-worker",
          "to": "redis-cache",
          "label": "vx:invalidate tenant and connection"
        },
        {
          "from": "platform-worker",
          "to": "smtp",
          "label": "Welcome e-mail"
        }
      ]
    },
    {
      "id": "staff-sso",
      "title": "Staff SSO into the OTA admin",
      "summary": "Open console mints a single-use portal token in Redis, the portal posts it to the OTA admin, and the OTA API turns it into a staff session.",
      "path": [
        {
          "from": "ota-staff",
          "to": "caddy",
          "label": "Open console on the portal"
        },
        {
          "from": "caddy",
          "to": "portal",
          "label": "POST /otas/<id>/console/launch"
        },
        {
          "from": "portal",
          "to": "platform-api",
          "label": "createConsoleToken"
        },
        {
          "from": "platform-api",
          "to": "pg-platform",
          "label": "Check membership and MFA"
        },
        {
          "from": "platform-api",
          "to": "redis-cache",
          "label": "SET ptk:<sha256> EX 60 NX"
        },
        {
          "from": "portal",
          "to": "ota-admin",
          "label": "Auto-submitted POST /sso"
        },
        {
          "from": "ota-admin",
          "to": "ota-api",
          "label": "console.auth.signIn (portal_token)"
        },
        {
          "from": "ota-api",
          "to": "redis-cache",
          "label": "GETDEL ptk, new staff family"
        },
        {
          "from": "ota-api",
          "to": "pg-platform",
          "label": "Membership, role, account status"
        }
      ]
    },
    {
      "id": "stripe-webhook",
      "title": "Stripe payment webhook",
      "summary": "Stripe reports a payment event; the OTA API verifies it, stores it once and the worker applies the new state.",
      "path": [
        {
          "from": "stripe",
          "to": "ota-api",
          "label": "payment_intent.succeeded, signed"
        },
        {
          "from": "ota-api",
          "to": "pg-tenant",
          "label": "payment_events (unique provider event id)"
        },
        {
          "from": "ota-api",
          "to": "redis-queues",
          "label": "ota-stripe-events job"
        },
        {
          "from": "redis-queues",
          "to": "ota-worker",
          "label": "Worker applies the event"
        },
        {
          "from": "ota-worker",
          "to": "pg-tenant",
          "label": "Payment captured / refunded / disputed"
        }
      ]
    },
    {
      "id": "platform-billing",
      "title": "Platform billing (Stripe Billing)",
      "summary": "With Stripe Billing on, create OTA goes through Stripe Checkout; the billing webhook opens the provisioning gate.",
      "path": [
        {
          "from": "owner",
          "to": "caddy",
          "label": "Create OTA"
        },
        {
          "from": "caddy",
          "to": "portal",
          "label": "Wizard submit"
        },
