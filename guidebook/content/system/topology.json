{
  "layers": [
    {
      "id": "users",
      "label": "People"
    },
    {
      "id": "edge",
      "label": "Edge"
    },
    {
      "id": "frontends",
      "label": "Frontends"
    },
    {
      "id": "apis-workers",
      "label": "APIs and workers"
    },
    {
      "id": "data",
      "label": "Data"
    },
    {
      "id": "external",
      "label": "External services"
    }
  ],
  "nodes": [
    {
      "id": "owner",
      "label": "OTA owner and team",
      "layer": "users",
      "kind": "user",
      "detail": "Signs up, creates and runs OTAs in the **portal**; opens the OTA admin with \"Open console\". Portal accounts in `platform.accounts`."
    },
    {
      "id": "velexis-staff",
      "label": "Velexis staff",
      "layer": "users",
      "kind": "user",
      "detail": "Platform admins (`is_platform_admin`, MFA mandatory): tenants, plans, subscriptions, Amadeus pool, settlements, jobs, audit."
    },
    {
      "id": "ota-staff",
      "label": "OTA staff",
      "layer": "users",
      "kind": "user",
      "detail": "Portal accounts with a membership (owner, admin, agent, finance, viewer); work in the OTA admin after SSO."
    },
    {
      "id": "traveller",
      "label": "Traveller",
      "layer": "users",
      "kind": "user",
      "detail": "Guest or signed-in customer of one OTA (`tenant_<key>.customers`); searches, books, pays, manages bookings."
    },
    {
      "id": "developer",
      "label": "Third-party developer",
      "layer": "users",
      "kind": "user",
      "detail": "Builds an own storefront or automation with the JS SDK and `pk_`/`sk_` keys against `api.ota.example.com`."
    },
    {
      "id": "caddy",
      "label": "Caddy + WAF",
      "layer": "edge",
      "app": "deploy",
      "kind": "edge",
      "detail": "Caddy 2.8.4 with Coraza and the OWASP Core Rule Set: TLS (automatic and on-demand), host routing, edge headers (`X-Velexis-Edge`, `X-Velexis-Host`) on storefront `/api/*`, CSP, blocks `/internal/*`. Locally the Vite dev server plays its storefront role."
    },
    {
      "id": "portal",
      "label": "Portal",
      "layer": "frontends",
      "app": "portal",
      "kind": "ui",
      "detail": "`platform/frontend`, Next.js 15 BFF on :3000 (`platform.example.com`): sign-up, OTA creation, set-up, keys, domains, team, billing, go-live, Open console."
    },
    {
      "id": "platform-admin",
      "label": "Platform admin",
      "layer": "frontends",
      "app": "platform-admin",
      "kind": "ui",
      "detail": "`platform/admin`, Next.js 15 BFF on :3001 (`admin.platform.example.com`) for Velexis staff."
    },
    {
      "id": "ota-admin",
      "label": "OTA admin",
      "layer": "frontends",
      "app": "ota-admin",
      "kind": "ui",
      "detail": "`ota/admin`, Next.js 15 BFF on :3002 (`admin.ota.example.com`); calls the OTA API with the SDK on the server (service key + staff token)."
    },
    {
      "id": "storefront",
      "label": "Hosted storefront",
      "layer": "frontends",
      "app": "storefront",
      "kind": "ui",
      "detail": "`ota/frontend`, static HTML + Tailwind + vanilla JS on `<key>.ota.example.com` and custom domains; the SDK in cookie mode, same-origin `/api`. Dev server :5173."
    },
    {
      "id": "third-party",
      "label": "Third-party frontend (SDK)",
      "layer": "frontends",
      "app": "sdk",
      "kind": "ui",
      "detail": "Any framework using `@velexis/ota-sdk` in token mode (publishable key + customer tokens) or server mode (secret key)."
    },
    {
      "id": "platform-api",
      "label": "Platform API",
      "layer": "apis-workers",
      "app": "platform-api",
      "kind": "api",
      "detail": "`platform/backend` `dist/main.js` on :3100 (`api.platform.example.com`): accounts, MFA, tenants, keys, domains, connections, billing, admin, `/internal/tls/ask`, Stripe billing webhooks."
    },
    {
      "id": "platform-worker",
      "label": "Platform worker",
      "layer": "apis-workers",
      "app": "platform-api",
      "kind": "worker",
      "detail": "`platform/backend` `dist/worker.js` (health :3101): provisioning post-steps, e-mails, Stripe events, DNS and TLS checks, credential checks, settlements, purges, key-usage flush."
    },
    {
      "id": "ota-api",
      "label": "OTA API",
      "layer": "apis-workers",
      "app": "ota-api",
      "kind": "api",
      "detail": "`ota/backend` `dist/main.js` on :4000 (`api.ota.example.com` and `/api/*` on storefront hosts): the 136-operation booking contract (117 implemented, 19 deferred with `501`), Amadeus, Stripe, payment webhooks."
    },
    {
      "id": "ota-worker",
      "label": "OTA worker",
      "layer": "apis-workers",
      "app": "ota-api",
      "kind": "worker",
      "detail": "`ota/backend` `dist/worker.js` (health :4001): tenant provisioning and migrations, ticketing retries, reconciliation, booking sync, payments, notifications, documents, queue polling."
    },
    {
      "id": "pg-platform",
      "label": "PostgreSQL: platform",
      "layer": "data",
      "app": "packages",
      "kind": "db",
      "detail": "Schema `platform` (accounts, tenants, memberships, keys, domains, connections, Amadeus accounts and offices, plans, subscriptions, settlements, jobs, outbox, audit). Written by the platform backend only; read-only for the OTA role."
    },
    {
      "id": "pg-reference",
      "label": "PostgreSQL: reference",
      "layer": "data",
      "app": "packages",
      "kind": "db",
      "detail": "Schema `reference`: airports, airlines, cities, countries, currencies, time zones, aircraft. Loaded by `pnpm db:seed:reference`."
    },
    {
      "id": "pg-tenant",
      "label": "PostgreSQL: tenant_<key>",
      "layer": "data",
      "app": "ota-api",
      "kind": "db",
      "detail": "One schema per OTA (about 45 tables: searches, offers, checkouts, bookings, payments, customers, settings, templates, staff actions). Only the OTA backend, always through `tenantTx`."
    },
    {
      "id": "redis-cache",
      "label": "Redis: caches and tokens",
      "layer": "data",
      "kind": "cache",
      "detail": "Redis 7.4: platform-row caches (`tenant:`, `host:`, `apikey:`, `conn:`, `member:`, 60 s), `t:<tenantId>:…`, `ptk:` SSO tokens, staff sessions, `staffdeny:`, Amadeus tokens and rate buckets, the `vx:invalidate` channel."
    },
    {
      "id": "redis-queues",
      "label": "Redis: BullMQ queues",
      "layer": "data",
      "kind": "queue",
      "detail": "Prefix `vx:`. `ota-tenant-ops`, `platform-tenant-events`, `platform-*` (emails, stripe-events, domains, connections, settlements, maintenance) and `ota-*` (stripe-events, payments, bookings, ticketing, notifications, documents, maintenance)."
    },
    {
      "id": "storage",
      "label": "Local storage",
      "layer": "data",
      "app": "ota-api",
      "kind": "storage",
      "detail": "`STORAGE_DIR` (`.local/storage` locally, `/var/lib/velexis/storage` on the VM): booking PDFs and storefront assets, served through signed URLs."
    },
    {
      "id": "amadeus",
      "label": "Amadeus Enterprise",
      "layer": "external",
      "app": "tools",
      "kind": "external",
      "detail": "Twelve flight operations (search, price, upsell, orders, issue, queues) for the OTA backend; OAuth token checks only for the platform worker. Locally the Amadeus stub on :4900."
    },
    {
      "id": "stripe",
      "label": "Stripe",
      "layer": "external",
      "kind": "external",
      "detail": "Billing subscriptions, Checkout, Customer Portal and Connect for the platform; PaymentIntents (manual capture), refunds and webhooks for OTA customer payments. Test mode only locally (Stripe CLI)."
    },
    {
      "id": "smtp",
      "label": "SMTP (Mailpit locally)",
      "layer": "external",
      "kind": "external",
      "detail": "Outgoing e-mail of both workers. Locally Mailpit catches everything on 1025 (UI :8025)."
    },
    {
      "id": "lets-encrypt",
      "label": "Let's Encrypt",
      "layer": "external",
      "kind": "external",
      "detail": "Certificates for the named hosts and, on demand, storefront sub-domains and verified custom domains."
    },
    {
      "id": "dns",
      "label": "Public DNS resolvers",
      "layer": "external",
      "kind": "external",
      "detail": "`DNS_RESOLVERS` (1.1.1.1, 8.8.8.8): TXT and CNAME/A checks of custom domains by the platform worker."
    },
    {
      "id": "backup",
      "label": "Off-site backups",
      "layer": "external",
      "app": "deploy",
      "kind": "storage",
      "detail": "Nightly age-encrypted PostgreSQL dumps and key backups copied off the VM (`velexis-backup.timer`)."
    }
  ],
