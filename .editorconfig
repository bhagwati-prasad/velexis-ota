# https://editorconfig.org — shared editor settings for every component.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 110

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
max_line_length = off

[*.sql]
max_line_length = off

[{Caddyfile,*.caddyfile}]
# `caddy fmt` uses tabs.
indent_style = tab

[Makefile]
indent_style = tab

[*.{service,timer,conf}]
max_line_length = off
