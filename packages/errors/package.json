{
  "name": "@velexis/errors",
  "version": "0.0.0",
  "private": true,
  "description": "One error model for both APIs (conventions §6): the error catalogue generated from the x-error-catalogue of the OTA and platform OpenAPI documents, AppError, and the HTTP error envelope. Pure TypeScript, no NestJS.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@velexis/api-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.6.3",
    "vitest": "3.2.7",
    "yaml": "2.9.1"
  }
}
