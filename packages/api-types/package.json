{
  "name": "@velexis/api-types",
  "version": "0.0.0",
  "private": true,
  "description": "Contract types generated from the OTA and platform OpenAPI documents, the operations index, the cross-backend queue messages and invalidation events with their Ajv validators, and the Redocly lint of those documents (ADR-0006, ADR-0009).",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./platform": {
      "types": "./dist/platform.d.ts",
      "default": "./dist/platform.js"
    },
    "./operations": {
      "types": "./dist/operations.d.ts",
      "default": "./dist/operations.js"
    },
    "./jobs": {
      "types": "./dist/jobs/index.d.ts",
      "default": "./dist/jobs/index.js"
    },
    "./fixtures/jobs/*.json": "./fixtures/jobs/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fixtures",
    "!dist/**/*.test.*",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "contracts:lint": "node scripts/contracts-lint.mjs",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@redocly/cli": "1.34.21",
    "@types/node": "22.20.5",
    "openapi-typescript": "7.13.0",
    "typescript": "5.6.3",
    "vitest": "3.2.7",
    "yaml": "2.9.1"
  }
}
