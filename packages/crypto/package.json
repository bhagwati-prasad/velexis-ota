{
  "name": "@velexis/crypto",
  "version": "0.0.0",
  "private": true,
  "description": "Envelope encryption of secrets at rest (AES-256-GCM, per-value data keys wrapped by a key-encryption key) with Node's built-in crypto only (ADR-0010).",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.6.3",
    "vitest": "3.2.7"
  }
}
