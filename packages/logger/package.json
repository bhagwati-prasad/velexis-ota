{
  "name": "@velexis/logger",
  "version": "0.0.0",
  "private": true,
  "description": "pino setup, standard fields, the central redaction list and the shared payload redactor (ADR-0016).",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "pino": "9.14.0",
    "pino-http": "10.5.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.6.3",
    "vitest": "3.2.7"
  }
}
