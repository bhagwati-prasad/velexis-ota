{
  "name": "@velexis/testing",
  "version": "0.0.0",
  "private": true,
  "description": "Test support only, never a runtime dependency (ADR-0022): migrated template databases cloned per test file, per-worker Redis databases, FakeClock, builders, OpenAPI response checks with Ajv, Mailpit helpers and the in-process Amadeus stub.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vitest-global-setup": {
      "types": "./dist/vitest-global-setup.d.ts",
      "default": "./dist/vitest-global-setup.js"
    },
    "./mailpit": {
      "types": "./dist/mailpit.d.ts",
      "default": "./dist/mailpit.js"
    },
    "./amadeus": {
      "types": "./dist/amadeus.d.ts",
      "default": "./dist/amadeus.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "lint": "eslint .",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@velexis/api-types": "workspace:*",
    "@velexis/config": "workspace:*",
    "@velexis/db": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "vitest": "3.2.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "6.4.24",
    "@types/pg": "8.23.1",
    "@velexis/amadeus-stub": "workspace:*",
    "nodemailer": "6.10.1",
    "typescript": "5.6.3",
    "vitest": "3.2.7"
  }
}
