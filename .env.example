# =====================================================================================================
# Velexis: shared LOCAL DEVELOPMENT defaults. Dummy values only — never put a real secret here (ADR-0010).
#
# How it is used (docs/mvp/local-development.md):
#   cp .env.example .env.local            # shared values for every app, read by @velexis/config
#   <app>/.env.local                      # optional per-app overrides (PORT, DATABASE_URL role, ...)
# Precedence: real environment > <app>/.env.local > root .env.local. On the VM the values come from
# /etc/velexis/<app>.env instead (deploy/env/*.env.example). Every new variable is added here, to its
# deploy/env template and to the configuration matrix in docs/mvp/architecture.md §6, in the same PR.
# =====================================================================================================

# ---- Runtime ---------------------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=debug
# PORT and HEALTH_PORT differ per process; each app's config has its local default (architecture.md §3):
#   portal 3000, platform admin 3001, OTA admin 3002, platform API 3100 (worker health 3101),
#   OTA API 4000 (worker health 4001), storefront Vite dev server 5173, Amadeus stub 4900.
# PORT=3100
# HEALTH_PORT=3101
# APIs: the proxies whose X-Forwarded-For is believed (Caddy and the Vite dev proxy run on loopback).
TRUST_PROXY=loopback

# ---- PostgreSQL 16 (local, created by deploy/scripts/dev-setup.sh) ----------------------------------
# Each backend connects with its own role (ADR-0004). Set the right one in the app's .env.local:
#   platform/backend/.env.local: DATABASE_URL=postgres://velexis_platform_app:dev_platform@127.0.0.1:5432/velexis
#   ota/backend/.env.local:      DATABASE_URL=postgres://velexis_ota_app:dev_ota@127.0.0.1:5432/velexis
DATABASE_URL=postgres://velexis_platform_app:dev_platform@127.0.0.1:5432/velexis
# DDL only: `pnpm db:migrate`, `pnpm db:migrate:tenants` and deploys. Never given to a running app.
DATABASE_MIGRATOR_URL=postgres://velexis_migrator:dev_migrator@127.0.0.1:5432/velexis
# OTA worker only: tenant provisioning as velexis_provisioner (tenant schemas only, nothing on platform; ADR-0004).
DATABASE_PROVISIONER_URL=postgres://velexis_provisioner:dev_provisioner@127.0.0.1:5432/velexis
# Integration tests create one database per test file from a migrated template (@velexis/testing). The role
# velexis_test_admin (LOGIN CREATEDB, member of velexis_migrator) exists only locally and in CI (ADR-0022).
TEST_DATABASE_ADMIN_URL=postgres://velexis_test_admin:dev_test_admin@127.0.0.1:5432/postgres

# ---- Redis 7.4 (local password set by deploy/scripts/dev-setup.sh with CONFIG SET requirepass) ---------
REDIS_URL=redis://:dev_redis@127.0.0.1:6379/0

# ---- Key files (generated by `pnpm dev:keys` into the ignored .local/keys/ folder) ---------------------
# tools/dev/dev-keys.mjs creates the five files of ADR-0010 (mode 0600, folder 0700) and .local/storage/.
# The paths are relative to the repository root, where .local/ is; a tool running elsewhere needs
# absolute paths.
MASTER_KEY_DIR=.local/keys
MASTER_KEY_CURRENT=local:v1
API_KEY_PEPPER_FILE=.local/keys/api-key-pepper
# Separate Ed25519 key per backend; set the OTA one in ota/backend/.env.local.
JWT_PRIVATE_KEY_FILE=.local/keys/platform-jwt-ed25519.pem
#   ota/backend/.env.local: JWT_PRIVATE_KEY_FILE=.local/keys/ota-jwt-ed25519.pem
# OTA backend only (signed document URLs, ADR-0010).
DOCUMENT_URL_KEY_FILE=.local/keys/document-url.key

# ---- E-mail: Mailpit (SMTP 1025, UI and API 8025) ----------------------------------------------------
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM="Velexis (dev) <no-reply@mail.ota.example.com>"
MAILPIT_API_URL=http://127.0.0.1:8025
# Platform backend: the recipient of ops.alert e-mails (pool low, live office request, failures; PADR-0013).
OPS_ALERT_EMAIL=ops@example.com

# ---- Public URLs (placeholder hosts of decisions.md §4; local ports of architecture.md §3) ------------
PUBLIC_PORTAL_URL=http://localhost:3000
PUBLIC_PLATFORM_ADMIN_URL=http://localhost:3001
PUBLIC_OTA_ADMIN_URL=http://localhost:3002
PUBLIC_OTA_API_URL=http://localhost:4000
STOREFRONT_BASE_DOMAIN=ota.example.com

# ---- Internal service URLs (server side only) ----------------------------------------------------------
PLATFORM_API_URL=http://127.0.0.1:3100
OTA_API_URL=http://127.0.0.1:4000

# ---- First-party credentials (dummy development values) ----------------------------------------------
# OTA admin server -> OTA API service credential (ADR-0008).
OTA_ADMIN_SERVICE_KEY=sk_dev_ota_admin_service_key_change_me
# Storefront edge credential: the Vite dev server (5173) adds it on /api like Caddy does (ADR-0018).
VELEXIS_EDGE_SECRET=dev_edge_secret_change_me
# Portal and platform admin servers -> platform API: authenticates the forwarded end-user IP and user agent
# (PADR-0019). One value for the platform API, the portal and the platform admin.
PLATFORM_BFF_KEY=dev_bff_key_change_me_0123456789abcdef

# ---- Storage (ADR-0017) ------------------------------------------------------------------------------
STORAGE_DRIVER=local
# Created by `pnpm dev:keys`; relative to the repository root like the key files.
STORAGE_DIR=.local/storage

# ---- Amadeus: the local stub (tools/amadeus-stub, `pnpm stub:amadeus`) ---------------------------------
# Shared Amadeus credentials are NOT environment variables; they live encrypted in platform.amadeus_accounts.
# The OTA backend calls the flight operations; the platform worker only requests tokens to verify credentials.
AMADEUS_BASE_URL_TEST=http://127.0.0.1:4900
AMADEUS_BASE_URL_LIVE=http://127.0.0.1:4900
# The stub's own port (tools/amadeus-stub/README.md), default 4900; change the two URLs above with it.
# STUB_PORT=4900
# Recording fixtures from the real Amadeus test environment (`pnpm --filter @velexis/amadeus-stub record`, X-034):
# your own test credentials, set only in your git-ignored .env.local or shell, never here; never used in CI.
# AMADEUS_RECORD_CLIENT_ID=
# AMADEUS_RECORD_CLIENT_SECRET=
# AMADEUS_RECORD_BASE_URL=https://test.travel.api.amadeus.com

# ---- Stripe (test mode only; `stripe listen` prints the webhook secrets) ------------------------------
# Platform backend (billing, M5)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_BILLING_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CONNECT_CLIENT_ID=ca_replace_me
# /webhooks/stripe/connect-accounts on the platform API (account.updated, account.application.deauthorized; M5)
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace_me
# OTA backend (customer payments on the Velexis account, M3). Live keys are never used locally.
STRIPE_SECRET_KEY_TEST=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY_TEST=pk_test_replace_me
STRIPE_SECRET_KEY_LIVE=
STRIPE_PUBLISHABLE_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_VELEXIS_TEST=whsec_replace_me
STRIPE_WEBHOOK_SECRET_VELEXIS_LIVE=
STRIPE_WEBHOOK_SECRET_CONNECT_TEST=whsec_replace_me
STRIPE_WEBHOOK_SECRET_CONNECT_LIVE=

# ---- Feature switches (no default except false; conventions §8) --------------------------------------
# OTA backend: the airline-card payment method (ADR-0011).
AIRLINE_CARD_ENABLED=false
# Platform backend (API and worker): the milestone switches of PADR-0015, all off until M5. Turn one on in
# platform/backend/.env.local to work on its feature; the portal and the admin read them from GET /v1/me.
FEATURE_STRIPE_BILLING=false
FEATURE_OWN_STRIPE=false
FEATURE_SETTLEMENTS=false
FEATURE_OWN_AMADEUS=false
FEATURE_CUSTOM_DOMAINS=false
FEATURE_LIVE_SWITCH=false
# Platform backend: OTAs that are not failed one account may own (PF-10 AC4).
MAX_TENANTS_PER_ACCOUNT=3

# ---- Optional error tracking (off when empty; ADR-0016) -----------------------------------------------
SENTRY_DSN=
