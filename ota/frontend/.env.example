# =====================================================================================================
# ota/frontend — hosted storefront: LOCAL DEVELOPMENT ONLY. Dummy values only.
#
# The storefront has NO runtime environment in production: it is static, and everything tenant-specific
# comes from storefront.get (docs/mvp/architecture.md §6). These variables are read only by vite.config.js
# (Node) for the dev server (5173) and `vite preview` (4173). Nothing here is prefixed VITE_, so nothing
# reaches the browser bundle.
#
# Load order in vite.config.js: root .env.local (shared values, see the root .env.example), then
# ota/frontend/.env.local (copy this file there to override). Never commit .env.local.
# =====================================================================================================

# OTA API that the dev proxy forwards /api/* to (path prefix /api stripped, like Caddy).
OTA_API_URL=http://127.0.0.1:4000

# Edge credential the proxy adds as X-Velexis-Edge, like Caddy does in production (ADR-0018).
# Must equal VELEXIS_EDGE_SECRET of the OTA backend. Development value only.
VELEXIS_EDGE_SECRET=dev_edge_secret_change_me

# Base domain of storefront hosts; used to build the default dev host demo.<base>.
STOREFRONT_BASE_DOMAIN=ota.example.com

# Storefront host the proxy sends as X-Velexis-Host (and as Origin, for the CSRF check).
# demo.ota.example.com is the tenant created by `pnpm --filter @velexis/ota-backend dev:seed`.
# Change it to try another seeded tenant.
STOREFRONT_DEV_HOST=demo.ota.example.com

# Dev server and preview ports (defaults shown).
STOREFRONT_DEV_PORT=5173
STOREFRONT_PREVIEW_PORT=4173
