{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@velexis/ota-sdk: the JSDoc types of src/ checked by tsc --checkJs (ADR-0019, ota/sdk/docs/types-and-builds.md §2). The SDK runs in browsers and Node 22, so no Node globals (types: []).",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*.js"]
}
