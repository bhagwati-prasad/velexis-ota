{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "generate": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/ota/backend/openapi/**",
        "$TURBO_ROOT$/platform/backend/openapi/**",
        "$TURBO_ROOT$/docs/velexis-sdk/openapi/**"
      ],
      "outputs": ["src/internal/operations.js", "test/contract/methods.generated.ts"]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.env*",
        "$TURBO_ROOT$/ota/backend/openapi/**",
        "$TURBO_ROOT$/docs/velexis-sdk/openapi/**",
        "$TURBO_ROOT$/docs/velexis-sdk/sdk/src/**"
      ]
    }
  }
}
