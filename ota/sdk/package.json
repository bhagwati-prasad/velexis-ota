{
  "name": "@velexis/ota-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Velexis OTA JavaScript SDK: vanilla ES2022 modules with JSDoc types checked by tsc --checkJs and no runtime dependencies, one method per OpenAPI operation of the OTA booking API (ADR-0019, OADR-0016).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "development": "./src/index.js",
      "import": "./dist/velexis-sdk.mjs",
      "default": "./dist/velexis-sdk.mjs"
    },
    "./iife": "./dist/velexis-sdk.iife.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "generate": "node scripts/generate-operations.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/build.mjs && node scripts/check-size.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:contract": "tsc -p tsconfig.build.json && tsc -p test/contract/tsconfig.json",
    "clean": "rm -rf dist coverage"
  },
  "devDependencies": {
    "@velexis/api-types": "workspace:*",
    "@velexis/testing": "workspace:*",
    "esbuild": "0.25.12",
    "happy-dom": "17.6.3",
    "typescript": "5.6.3",
    "vitest": "3.2.7",
    "yaml": "2.9.1"
  }
}
