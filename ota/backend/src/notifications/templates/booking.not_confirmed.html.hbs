<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Your booking could not be confirmed</title>
  </head>
  <body style="margin:0;padding:24px;background:#f5f6f8;font-family:Arial,Helvetica,sans-serif;color:#1f2933;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:8px;">
      <tr>
        <td style="padding:32px;">
          <p style="margin:0 0 16px;font-size:20px;font-weight:bold;">{{brand.name}}</p>
          <p style="margin:0 0 16px;">{{#if booking.contact.firstName}}Hello {{booking.contact.firstName}},{{else}}Hello,{{/if}}</p>
          <p style="margin:0 0 16px;">We are sorry: the airline could not confirm your booking {{booking.reference}}, so the flights below are <strong>not</strong> booked.</p>
          <p style="margin:0 0 16px;">You have not been charged. The amount held on your card is being released; depending on your bank it can take a few days to disappear from your account.</p>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 16px;font-size:14px;">
            <tr><td style="padding:4px 0;color:#52606d;">Booking reference</td><td style="padding:4px 0;text-align:right;font-weight:bold;">{{booking.reference}}</td></tr>
            {{#if booking.recordLocator}}
            <tr><td style="padding:4px 0;color:#52606d;">Airline reference</td><td style="padding:4px 0;text-align:right;">{{booking.recordLocator}}</td></tr>
            {{/if}}
            <tr><td style="padding:4px 0;color:#52606d;">Amount held</td><td style="padding:4px 0;text-align:right;">{{booking.total.amount}} {{booking.total.currency}}</td></tr>
          </table>
          <p style="margin:0 0 8px;font-weight:bold;">Flights</p>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 16px;font-size:14px;border-collapse:collapse;">
            {{#each booking.segments}}
            <tr><td style="padding:8px 0;border-top:1px solid #e4e7eb;"><strong>{{carrierCode}} {{flightNumber}}</strong> &nbsp;{{origin}} to {{destination}}<br>Departs {{departureAt}}, arrives {{arrivalAt}} (local times)</td></tr>
            {{/each}}
          </table>
          <p style="margin:0 0 16px;font-size:14px;">The details of this booking stay on your booking page: <a href="{{booking.url}}">{{booking.url}}</a></p>
          <p style="margin:0 0 24px;">
            <a href="{{brand.storefrontUrl}}" style="display:inline-block;padding:12px 20px;background:#1f5eff;color:#ffffff;text-decoration:none;border-radius:6px;">Search for flights again</a>
          </p>
          {{#if brand.supportEmail}}
          <p style="margin:0 0 16px;font-size:14px;">Questions? Write to <a href="mailto:{{brand.supportEmail}}">{{brand.supportEmail}}</a>{{#if brand.supportPhone}} or call {{brand.supportPhone}}{{/if}}.</p>
          {{else}}
          {{#if brand.supportPhone}}
          <p style="margin:0 0 16px;font-size:14px;">Questions? Call {{brand.supportPhone}}.</p>
          {{/if}}
          {{/if}}
          <p style="margin:0;font-size:14px;"><a href="{{brand.storefrontUrl}}">{{brand.name}}</a></p>
        </td>
      </tr>
    </table>
  </body>
</html>
