{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "OTA backend build: src/ to dist/ as CommonJS with source maps (dist/main.js, dist/worker.js, dist/cli.js); tests excluded.",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
