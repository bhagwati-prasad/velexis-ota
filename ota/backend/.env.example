# OTA backend (@velexis/ota-backend) - example environment.
# Dummy values only - never put a real secret, key or card number here (ADR-0010).
# Copy to ota/backend/.env.local for development (precedence: real environment > ota/backend/.env.local > root .env.local).
# On the VM the real values live in /etc/velexis/ota-backend.env (API and worker) and /etc/velexis/ota-worker.env
# (worker only: DATABASE_MIGRATOR_URL), root:root 0600 (ADR-0026). Every variable is validated by src/config.ts;
# see ota/backend/README.md section 3 and the configuration matrix in docs/mvp/architecture.md section 6.

# --- Process ----------------------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=debug
# API port (API process). The worker uses HEALTH_PORT only.
PORT=4000
HEALTH_PORT=4001
# Client IPs come from Caddy (or the Vite dev proxy) on loopback
TRUST_PROXY=loopback

# --- PostgreSQL and Redis ---------------------------------------------------------------------------
# Role velexis_ota_app: DML on tenant schemas, SELECT on reference and on selected platform tables (ADR-0004).
DATABASE_URL=postgres://velexis_ota_app:dev_ota@127.0.0.1:5432/velexis
# Worker only: tenant provisioning and migrations as velexis_migrator. Never used to serve requests.
DATABASE_MIGRATOR_URL=postgres://velexis_migrator:dev_migrator@127.0.0.1:5432/velexis
REDIS_URL=redis://:dev_redis@127.0.0.1:6379/0

# --- Key files (created by `pnpm dev:keys` in .local/keys/) -------------------------------------------
MASTER_KEY_DIR=.local/keys
MASTER_KEY_CURRENT=local:v1
# Same pepper file as the platform backend (API key hashes are created there, verified here).
API_KEY_PEPPER_FILE=.local/keys/api-key-pepper
# The OTA backend has its own Ed25519 signing key (customer and staff tokens).
JWT_PRIVATE_KEY_FILE=.local/keys/ota-jwt-ed25519.pem
DOCUMENT_URL_KEY_FILE=.local/keys/document-url.key

# --- E-mail (Mailpit in development: SMTP 1025, UI 8025) ---------------------------------------------
SMTP_URL=smtp://127.0.0.1:1025
# The display name is replaced by the OTA brand; Reply-To is the OTA's support e-mail (ADR-0017).
MAIL_FROM="Velexis OTA (dev) <no-reply@mail.ota.example.com>"
# Velexis ops alerts (airline-card abuse, refused Amadeus credentials).
OPS_ALERT_EMAIL=ops@example.com

# --- Public URLs and hosts (placeholders of docs/mvp/decisions.md section 4) -------------------------
PUBLIC_OTA_API_URL=http://localhost:4000
PUBLIC_OTA_ADMIN_URL=http://localhost:3002
STOREFRONT_BASE_DOMAIN=ota.example.com

# --- First-party credentials (ADR-0008, ADR-0018); same values in the OTA admin, Caddy and Vite proxy ---
VELEXIS_EDGE_SECRET=dev_edge_secret_change_me
OTA_ADMIN_SERVICE_KEY=sk_dev_ota_admin_service_key_change_me

# --- Stripe, Velexis account (test mode only locally; `stripe listen` prints the webhook secret) --------
STRIPE_SECRET_KEY_TEST=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY_TEST=pk_test_replace_me
STRIPE_WEBHOOK_SECRET_VELEXIS_TEST=whsec_replace_me
# Live keys are never used locally.
STRIPE_SECRET_KEY_LIVE=
STRIPE_PUBLISHABLE_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_VELEXIS_LIVE=
# Connect endpoint (M5)
STRIPE_WEBHOOK_SECRET_CONNECT_TEST=whsec_replace_me
STRIPE_WEBHOOK_SECRET_CONNECT_LIVE=

# --- Amadeus: the local stub (tools/amadeus-stub, `pnpm stub:amadeus`) ---------------------------------
# Credentials are NOT here: the Velexis test account lives encrypted in platform.amadeus_accounts
# (the platform's dev:seed creates one with dummy credentials that the stub accepts).
AMADEUS_BASE_URL_TEST=http://127.0.0.1:4900
AMADEUS_BASE_URL_LIVE=http://127.0.0.1:4900

# --- Feature switches (no default except false; conventions section 8) -------------------------------
# Airline-card payment method (ADR-0011). true only in development and CI until the M6 security review.
AIRLINE_CARD_ENABLED=true

# --- Storage (ADR-0017) ----------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_DIR=.local/storage

# --- Tests ------------------------------------------------------------------------------------------
TEST_DATABASE_ADMIN_URL=postgres://velexis_test_admin:dev_test_admin@127.0.0.1:5432/postgres
MAILPIT_API_URL=http://127.0.0.1:8025

# --- Optional error tracking (off when empty; ADR-0016) -----------------------------------------------
SENTRY_DSN=
