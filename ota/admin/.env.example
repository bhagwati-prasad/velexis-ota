# =====================================================================================================
# ota/admin — OTA admin (Next.js 15, port 3002): LOCAL DEVELOPMENT values. Dummy values only.
#
# Copy to ota/admin/.env.local only to override the shared root .env.local (see the root .env.example).
# Precedence (@velexis/config): real environment > ota/admin/.env.local > root .env.local.
# On the VM the values come from /etc/velexis/ota-admin.env (deploy/env/ota-admin.env.example).
# No NEXT_PUBLIC_ variable exists in this app: nothing here may reach the browser (ADR-0014).
# =====================================================================================================

APP_ENV=development
LOG_LEVEL=debug
PORT=3002

# Public URLs (placeholder hosts of docs/mvp/decisions.md §4 in production; local ports here).
PUBLIC_OTA_ADMIN_URL=http://localhost:3002
# The portal: SSO hand-off Origin check, "back to the portal" redirects and portal links.
PUBLIC_PORTAL_URL=http://localhost:3000

# OTA API on a direct loopback connection: the OTA backend accepts the service key only on loopback and only
# without X-Forwarded-For / X-Forwarded-Host, i.e. never through Caddy (OADR-0009 rule 1.2, OADR-0011).
OTA_API_URL=http://127.0.0.1:4000

# First-party service credential (SDK secretKey). Must equal OTA_ADMIN_SERVICE_KEY of the OTA backend.
# Development value only; production reads it from /etc/velexis/ota-admin.env.
OTA_ADMIN_SERVICE_KEY=sk_dev_ota_admin_service_key_change_me

# Optional error tracking; off when empty (ADR-0016).
SENTRY_DSN=
