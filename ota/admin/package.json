    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "17.6.3",
    "tailwindcss": "4.1.18",
    "typescript": "5.6.3",
    "vitest": "3.2.7"
