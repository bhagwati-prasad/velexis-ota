{
  "name": "@velexis/ota-admin",
  "version": "0.0.0",
  "private": true,
  "description": "Velexis OTA admin: Next.js 15 App Router back office for an OTA's staff, a backend-for-frontend of the OTA API through the JS SDK (ADR-0014, OADR-0018).",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev --port 3002 --hostname 127.0.0.1",
    "build": "next build && node -e \"require('node:fs').accessSync('.next/standalone/ota/admin/server.js')\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf .next coverage"
  },
  "dependencies": {
    "@velexis/config": "workspace:*",
    "lucide-react": "1.48.0",
    "next": "15.5.27",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "17.6.3",
    "tailwindcss": "4.1.18",
    "typescript": "5.6.3",
    "vitest": "3.2.7"
  }
}
