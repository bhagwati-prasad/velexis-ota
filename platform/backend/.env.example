# Platform backend (@velexis/platform-backend) - example environment.
# Dummy values only. Copy to .env.local for development. On the VM both processes read
# /etc/velexis/platform-backend.env (template deploy/env/platform-backend.env.example, root:root 0600);
# the worker also reads the optional overlay /etc/velexis/platform-worker.env (worker-only overrides).
# Every variable is validated by src/config.ts; see platform/backend/README.md section 3.

# --- Process ----------------------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=debug
PORT=3100
# Worker health port (worker process only)
HEALTH_PORT=3101
# Client IPs come from Caddy on loopback
TRUST_PROXY=loopback

# --- PostgreSQL and Redis (development passwords set by deploy/scripts/dev-setup.sh, as the root .env.example) ---
DATABASE_URL=postgres://velexis_platform_app:dev_platform@127.0.0.1:5432/velexis
# Used only by pnpm db:migrate and the deploy script
DATABASE_MIGRATOR_URL=postgres://velexis_migrator:dev_migrator@127.0.0.1:5432/velexis
REDIS_URL=redis://:dev_redis@127.0.0.1:6379/0

# --- Key files (created by pnpm dev:keys in .local/keys/) -------------------------------------------
MASTER_KEY_DIR=./.local/keys
MASTER_KEY_CURRENT=local:v1
API_KEY_PEPPER_FILE=./.local/keys/api-key-pepper
JWT_PRIVATE_KEY_FILE=./.local/keys/platform-jwt-ed25519.pem

# --- First-party callers (PADR-0019) ----------------------------------------------------------------
# Same value in the portal's and the admin's .env.local. Only requests carrying it may forward the
# end user's IP and user agent (X-Velexis-End-User-IP / X-Velexis-End-User-Agent).
PLATFORM_BFF_KEY=dev_bff_key_change_me_0123456789abcdef

# --- E-mail (Mailpit in development) ----------------------------------------------------------------
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM='"Velexis" <no-reply@mail.platform.example.com>'
OPS_ALERT_EMAIL=ops@example.com

# --- Public URLs and hosts (placeholders of docs/mvp/decisions.md section 4) ------------------------
PUBLIC_PORTAL_URL=http://localhost:3000
PUBLIC_PLATFORM_ADMIN_URL=http://localhost:3001
PUBLIC_OTA_ADMIN_URL=http://localhost:3002
STOREFRONT_BASE_DOMAIN=ota.example.com
# Apex-domain records shown to OTA owners and checked by DNS verification (M5): STOREFRONT_IPV4 is required while
# FEATURE_CUSTOM_DOMAINS is on; STOREFRONT_IPV6 is optional (no AAAA record without it)
STOREFRONT_IPV4=203.0.113.10
STOREFRONT_IPV6=2001:db8::10
DNS_RESOLVERS=1.1.1.1,8.8.8.8

# --- Amadeus (only to verify OTA-owned credentials; the shared Velexis account is in the database) ---
AMADEUS_BASE_URL_TEST=http://127.0.0.1:4900
AMADEUS_BASE_URL_LIVE=http://127.0.0.1:4900

# --- Stripe, Velexis account (M5) -------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_BILLING_WEBHOOK_SECRET=whsec_dummy_billing
STRIPE_CONNECT_CLIENT_ID=ca_dummy
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_dummy_connect

# --- Limits and milestone switches (PADR-0015; all false until M5) ----------------------------------
MAX_TENANTS_PER_ACCOUNT=3
FEATURE_STRIPE_BILLING=false
FEATURE_OWN_STRIPE=false
FEATURE_SETTLEMENTS=false
FEATURE_OWN_AMADEUS=false
FEATURE_CUSTOM_DOMAINS=false
FEATURE_LIVE_SWITCH=false

# --- Optional ---------------------------------------------------------------------------------------
# Listed for the platform in the configuration matrix; not read by the MVP code
STORAGE_DRIVER=local
STORAGE_DIR=./.local/storage
# Error tracking is off when empty
SENTRY_DSN=
