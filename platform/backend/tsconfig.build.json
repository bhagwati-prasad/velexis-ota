{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Platform backend build: src/ to dist/ as CommonJS with source maps (dist/main.js, dist/worker.js, dist/cli.js); tests excluded. `tsc -b` builds the referenced workspace packages first.",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"],
  "references": [
    { "path": "../../packages/config" },
    { "path": "../../packages/logger" },
    { "path": "../../packages/db" },
    { "path": "../../packages/errors" }
  ]
}
