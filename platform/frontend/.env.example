# Portal (@velexis/platform-frontend) - example environment.
# Dummy values only. Copy to .env.local for development. On the VM: /etc/velexis/portal.env.
# Read only in server code through @velexis/config. No NEXT_PUBLIC_ variable may hold a key or token.

APP_ENV=development
LOG_LEVEL=debug
# Next.js standalone server binding (127.0.0.1 only; Caddy is the public entry)
PORT=3000
HOSTNAME=127.0.0.1

# Platform API, called from server code only
PLATFORM_API_URL=http://127.0.0.1:3100

# Public URLs (placeholders of docs/mvp/decisions.md section 4; https in production)
PUBLIC_PORTAL_URL=http://localhost:3000
PUBLIC_OTA_ADMIN_URL=http://localhost:3002
STOREFRONT_BASE_DOMAIN=ota.example.com

# Error tracking is off when empty
SENTRY_DSN=
