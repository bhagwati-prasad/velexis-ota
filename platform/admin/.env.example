# Platform admin (@velexis/platform-admin) - example environment.
# Dummy values only. Copy to .env.local for development. On the VM: /etc/velexis/platform-admin.env.
# Read only in server code through @velexis/config. No NEXT_PUBLIC_ variable may hold a key or token.

APP_ENV=development
LOG_LEVEL=debug
# Next.js standalone server binding (127.0.0.1 only; Caddy is the public entry)
PORT=3001
HOSTNAME=127.0.0.1

# Platform API, called from server code only (admin surface /v1/admin)
PLATFORM_API_URL=http://127.0.0.1:3100

# Public URLs (placeholders of docs/mvp/decisions.md section 4; https in production)
PUBLIC_PLATFORM_ADMIN_URL=http://localhost:3001
# Admins enable MFA in the portal before their first admin sign-in
PUBLIC_PORTAL_URL=http://localhost:3000

# Error tracking is off when empty
SENTRY_DSN=
