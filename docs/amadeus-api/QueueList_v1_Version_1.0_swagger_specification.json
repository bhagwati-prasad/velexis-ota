  "components": {
    "schemas": {
      "pnr": {
        "title": "PNR list",
        "allOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "type of API result \"pnrList\""
              }
            }
          },
          {
            "type": "object",
            "title": "PNRModel",
            "description": "",
            "properties": {
              "id": {
                "type": "string",
                "description": "id of Passenger name record",
                "example": "ABC123-2019-10-05"
              },
              "creation": {
                "title": "EventLog",
                "type": "object",
                "description": "The object representing one event and its details",
                "properties": {
                  "dateTime": {
                    "type": "string",
                    "description": "time of the change",
                    "format": "datetime",
                    "example": "2018-11-19T04:54"
                  }
                }
              },
              "travelers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "description": "Definition of PNR travelers. Fields gender, nationality, placeOfBirth, countryOfResidence are only populated for passengerDelivery resources.",
                  "x-examples": {},
                  "title": "Stakeholder",
                  "properties": {
                    "names": {
                      "description": "Names of the stakeholder. The concatenation of full name + PTC + staffType + dateOfBirth + specialSeat must remain below 59 characters.",
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 5,
                      "items": {
                        "type": "object",
                        "description": "Description of the name of a physical person",
                        "title": "Name",
                        "x-tags": [
                          "Name",
                          "PII"
                        ],
                        "properties": {
                          "firstName": {
                            "description": "First name.",
                            "type": "string",
                            "x-risk-personal-data-field": "PASSENGER_NAME"
                          },
                          "lastName": {
                            "description": "Last name.",
                            "type": "string",
                            "x-risk-personal-data-field": "PASSENGER_NAME"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "products": {
                "type": "array",
                "description": "A product is either a flight segment or a service booked in reservation",
                "items": {
                  "type": "object",
                  "description": "A product can either be a flight segment, a standalone service / air service i.e. related to flight segment(s), or a seat request made on a given flight segment. A service can be auxiliary [SVC] or ancillary i.e. a Special Service Request [SSR].",
                  "title": "Product",
                  "properties": {
                    "airSegment": {
                      "type": "object",
                      "description": "Product Delivery Information related to segments",
                      "title": "SegmentDelivery",
                      "properties": {
                        "segment": {
                          "type": "object",
                          "description": "Defining a flight segment, including both Operating and Marketing details when applicable - seats refer to SEATING product(s) & services refer to AIR_SERVICE product(s)",
                          "title": "FlightSegment",
                          "x-examples": {},
                          "properties": {
                            "arrival": {
                              "type": "object",
                              "description": "Departure or arrival information ",
                              "x-examples": {},
                              "title": "FlightSegment EndPoint",
                              "properties": {
                                "iataCode": {
                                  "description": "IATA Airport code",
                                  "type": "string",
                                  "example": "JFK"
                                },
                                "localDateTime": {
                                  "type": "string",
                                  "description": "Local schedule dateTime of the departure or arrival.\nConversion of dateTime in local date time.",
                                  "format": "date-time",
                                  "example": "2020-01-13T17:09:00"
                                }
                              }
                            },
                            "carrierCode": {
                              "type": "string",
                              "description": "Providing the airline / carrier code",
                              "minLength": 1,
                              "maxLength": 2,
                              "example": "AC"
                            },
                            "number": {
                              "type": "string",
                              "description": "The flight number as assigned by the carrier",
                              "minLength": 1,
                              "maxLength": 4,
                              "example": "123"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
