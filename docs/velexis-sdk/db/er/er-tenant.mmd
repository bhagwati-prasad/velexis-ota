---
title: Velexis tenant schema - one copy per OTA (tenant_<key>)
---
erDiagram
  booking_access_tokens {
    text id PK "Token id (bat_ + ULID)."
    text booking_id FK "Booking the token grants access to."
    text token_hash UK "SHA-256 of the token."
    timestamptz expires_at "Expiry."
    timestamptz revoked_at "Revocation time."
  }
  booking_ancillaries {
    text id PK "Ancillary id (anc_ + ULID)."
    text booking_id FK "Booking."
    text booking_traveler_id FK "Traveller (NULL = whole order)."
    text booking_segment_id FK "Segment (NULL = all segments / itinerary)."
    text type "Amadeus AdditionalServiceType."
    numeric price_amount "Selling price."
    text status "Service state (issued = EMD issued)."
    text emd_ticket_id FK "EMD that paid for the service."
  }
  booking_associated_records {
    text id PK "Associated record id (bar_ + ULID)."
    text booking_id FK "Booking."
    text reference "Record locator (Amadeus or other airline)."
    text origin_system_code "System that created the record, e.g. 1A or a carrier code."
  }
  booking_contacts {
    text id PK "Booking contact id (bco_ + ULID)."
    text booking_id FK "Booking."
    text purpose "Amadeus ContactPurpose."
    text email "emailAddress."
  }
  booking_documents {
    text id PK "Document id (doc_ + ULID)."
    text booking_id FK "Booking."
    text booking_ticket_id FK "Ticket an e-ticket / EMD receipt belongs to."
    text kind "Document kind."
    text status "Generation state."
    text storage_key UK "Object-storage key (bucket path, server-side encrypted)."
    text content_hash "SHA-256 of the file (integrity, deduplication)."
  }
  booking_events {
    text id PK "Event id (evt_ + ULID)."
    text booking_id FK "Booking."
    text type "Event type, e.g. booking.created, booking.ticketed, booking.synced, booking.schedule_changed."
    text actor_type "Who caused it."
    text supplier_request_id FK "Amadeus call behind the event."
    timestamptz created_at "Event time."
  }
  booking_remarks {
    text id PK "Remark id (rmk_ + ULID)."
    text booking_id FK "Booking."
    text kind "remarks.general or remarks.airline."
    text sub_type "GeneralRemarkType or AirlineRemarkType."
    text text "Remark free text."
  }
  booking_segments {
    text id PK "Booking segment id (seg_ + ULID)."
    text booking_id FK "Booking."
    text amadeus_segment_id "Amadeus segment id (referenced by tickets, remarks, services)."
    smallint itinerary_index "0-based itinerary (bound) index."
    smallint segment_index "0-based position inside the itinerary."
    text carrier_code "Marketing carrier (IATA, by value)."
    text flight_number "Flight number."
    char departure_iata "Departure airport (IATA, by value)."
    timestamptz departure_at "Departure instant (UTC, via airport time zone)."
    char arrival_iata "Arrival airport."
    timestamptz arrival_at "Arrival instant (UTC)."
    text cabin "Cabin (of the lead traveller)."
    text booking_class "Booking class / RBD."
    text fare_basis "Fare basis code."
    text branded_fare "Branded fare (fare family) name, e.g. LIGHTONE."
    text status "Amadeus bookingStatus."
  }
  booking_tickets {
    text id PK "Ticket id (tkt_ + ULID)."
    text booking_id FK "Booking."
    text booking_traveler_id FK "Ticketed traveller."
    text document_type "Amadeus documentType."
    text document_number "Document number prefixed by the airline accounting code."
    text status "Amadeus documentStatus."
    numeric total_amount "Document total."
    timestamptz issued_at "Issue time."
    text exchanged_to_ticket_id FK "New document when this one was EXCHANGED."
  }
  booking_travelers {
    text id PK "Booking traveller id (btr_ + ULID)."
    text booking_id FK "Booking."
    text saved_traveler_id FK "Saved traveller it came from."
    text amadeus_traveler_id "Amadeus traveler id in the order ('1', '2' ...)."
    text traveler_type "Amadeus TravelerType."
    text first_name "name.firstName."
    text last_name "name.lastName."
  }
  bookings {
    text id PK "Booking id (bkg_ + ULID)."
    text environment "Amadeus environment of the flight order."
    text reference UK "Velexis booking reference shown to customers (lookup with last name)."
    text customer_id FK "Customer (NULL = guest booking, accessed with booking tokens)."
    text checkout_id FK, UK "Checkout that produced the booking (one booking per checkout)."
    text priced_offer_id FK "Priced offer that was booked."
    text status "Booking state."
    text amadeus_order_id "Amadeus flight-order id (data.id)."
    text record_locator "Main record locator (associatedRecords[0].reference, Amadeus 1A)."
    text origin_system_code "originSystemCode of the main record, e.g. 1A."
    timestamptz ticketing_deadline_at "Absolute ticketing deadline (lastTicketingDate / ticketingAgreement in office time zone)."
    text ticketing_status "Issuance state (API IssuanceStatus); failed = retried by the issuance job until the deadline."
    timestamptz first_departure_at "First segment departure (UTC) - upcoming/past ordering."
    timestamptz last_arrival_at "Last segment arrival (UTC) - a trip is past once this is over."
    text pricing_mode "How the selling price was set (console create/import may sell at net or at an override)."
    text markup_rule_id FK "Markup rule applied (pricing_mode = markup_rules; NULL for net / override or a deleted rule)."
    numeric net_amount "Amadeus grandTotal incl. booked services (net cost)."
    numeric total_amount "Selling total paid by the customer."
    text contact_email "Primary contact e-mail (guest lookup and notifications)."
    jsonb order_snapshot "Latest Amadeus flight-order data after the redaction rule (document, discount card and certi..."
    timestamptz last_synced_at "Last refresh from Flight Order Management GET."
    timestamptz created_at "Booking time."
  }
  checkout_ancillaries {
    text id PK "Selection id (can_ + ULID)."
    text checkout_id FK "Checkout."
    text checkout_traveler_id FK "Traveller (NULL = all travellers when bookable per order)."
    text type "Amadeus AdditionalServiceType."
    numeric price_amount "Selling price of the selection."
  }
  checkout_contacts {
    text id PK "Checkout contact id (cco_ + ULID)."
    text checkout_id FK "Checkout."
    text purpose "Amadeus ContactPurpose."
    text email "emailAddress."
  }
  checkout_remarks {
    text id PK "Checkout remark id (crm_ + ULID)."
    text checkout_id FK "Checkout."
    text text "Request text as entered (Amadeus remark character set; upper-cased and prefixed when sent)."
    smallint position "Order of the request (at most 5 per checkout)."
  }
  checkout_travelers {
    text id PK "Checkout traveller id (ctr_ + ULID)."
    text checkout_id FK "Checkout."
    text saved_traveler_id FK "Saved traveller it was prefilled from."
    text amadeus_traveler_id "travelerId of the priced offer travelerPricings ('1', '2' ...)."
    text traveler_type "Amadeus TravelerType."
    text first_name "Given name."
    text last_name "Family name."
  }
  checkouts {
    text id PK "Checkout id (chk_ + ULID)."
    text environment "Environment (must match the priced offer)."
    text customer_id FK "Customer (NULL = guest checkout)."
    boolean is_guest "Started as a guest (kept even if the customer is later erased)."
    text base_priced_offer_id FK "Priced offer the checkout was opened with, without ancillaries (ancillary catalogue of setAn..."
    text priced_offer_id FK "Priced offer being bought now (= base, or the ancillary / re-price child); kept while the ch..."
    text status "Checkout state."
    numeric total_amount "Amount to pay."
    timestamptz expires_at "Expiry (CHECKOUT_EXPIRED; expiry job)."
    timestamptz created_at "Start time."
  }
  customer_consents {
    text id PK "Consent event id (ccn_ + ULID)."
    text customer_id FK "Customer."
    text kind "What the event is about."
    text policy_version "Terms / privacy policy version (storefront legal versions); NULL for marketing."
    boolean granted "true = accepted / given, false = withdrawn."
    text source "Where the change came from."
    timestamptz created_at "Event time."
  }
  customer_data_exports {
    text id PK "Export id (dex_ + ULID)."
    text customer_id FK "Customer whose data is exported."
    text status "Job state."
    text format "File format inside the ZIP."
    text storage_key UK "Object-storage key of the ZIP (tenant prefix, SSE-KMS); NULL until ready, file deleted at ex..."
    timestamptz expires_at "When the file is deleted (ready_at + 7 days)."
    timestamptz created_at "Request time (requestedAt)."
  }
  customer_identities {
    text id PK "Identity id (cid_ + ULID)."
    text customer_id FK "Customer."
    text provider "Login method."
    text provider_subject "Subject at the provider (lower-cased e-mail for password, OIDC sub otherwise); rewritten whe..."
    text verification_token_hash UK "SHA-256 of the pending e-mail verification token (sign-up address or customers.pending_email)."
    timestamptz disabled_at "When the identity was disabled (account.delete, staff); a disabled identity cannot sign in a..."
  }
  customer_password_resets {
    text id PK "Reset id (pwr_ + ULID)."
    text customer_id FK "Customer."
    text token_hash UK "SHA-256 of the reset token."
    timestamptz expires_at "Token expiry (e.g. 1 hour)."
  }
  customer_preferences {
    text id PK "Preferences id (cpf_ + ULID)."
    text customer_id FK, UK "Customer (one-to-one)."
  }
  customer_sessions {
    text id PK "Session id (ses_ + ULID), also carried as sid in the access token."
    text customer_id FK "Customer."
    text identity_id FK "Identity used to sign in."
    text refresh_token_hash UK "SHA-256 of the opaque refresh token."
    text family_id "Rotation family; presenting an already rotated token revokes the whole family."
    text replaced_by_id FK "Token that replaced this one at rotation."
    boolean remember_me "rememberMe at sign-in (copied on rotation): 30-day instead of 12-hour family lifetime."
    timestamptz family_expires_at "Absolute end of the family (sign-in + 30 d or 12 h); rotation never extends it."
    timestamptz expires_at "Refresh token expiry (never after family_expires_at)."
  }
  customers {
    text id PK "Customer id (cus_ + ULID)."
    text email UK "Login and contact e-mail (unique case-insensitively). account.delete replaces it with '<HMAC..."
    text first_name "Given name."
    text last_name "Family name."
    text status "Account state."
    timestamptz created_at "Sign-up time."
  }
  fee_rules {
    text id PK "Fee rule id (fee_ + ULID)."
    text name "Internal rule name."
    text fee_type "What the fee is charged for."
    jsonb scope "Matching criteria (same shape as markup_rules.scope, plus cardBrands for payment_card)."
    text calculation "How the fee is computed."
    int priority "Evaluation order (lower first)."
    boolean is_active "Enabled flag."
  }
  flight_offers {
    text id PK "Offer id (off_ + ULID)."
    text origin "How the offer entered the cache."
    text search_id FK "Search that returned it."
    text upsell_id FK "Upsell call that returned it (FK added below, circular with offer_upsells)."
    text amadeus_offer_id "Amadeus flight-offer id within its response, e.g. '1'."
    jsonb payload "Verbatim AmadeusFlightOffer (net prices)."
    numeric net_total "Amadeus price.grandTotal (net)."
    numeric markup_amount "Markup applied by markup_rules."
    numeric selling_total "Price shown to the customer (net + markup)."
    text markup_rule_id FK "Rule that produced the markup."
    text validating_carrier "First validatingAirlineCodes entry."
    text_array marketing_carriers "Marketing carriers of all segments (carriers filter: contained in the requested list; facets)."
    timestamp first_departure_local "First segment departure (local time, as Amadeus gives it; departure sort)."
    timestamptz expires_at "Cache expiry (OFFER_EXPIRED afterwards; purge job)."
  }
  flight_searches {
    text id PK "Search id (srch_ + ULID)."
    text environment "Amadeus environment used (from the API key)."
    text kind "offers = FlightOffersSearch, availability = FlightAvailabilitiesSearch."
    text mode "simple = Velexis criteria (GET-style), advanced = full Amadeus POST body."
    text customer_id FK "Signed-in customer (NULL = anonymous or staff)."
    jsonb criteria "Normalised Velexis search criteria as received."
    text status "Search state."
    int result_count "Offers (or availability options) returned."
    timestamptz expires_at "When the cached results expire (SEARCH_EXPIRED afterwards)."
    timestamptz created_at "Search time."
  }
  idempotency_keys {
    text id PK "Record id (idk_ + ULID)."
    text scope "Principal + environment + operation, e.g. live:key_123:checkouts.create or live:cus_9:bookin..."
    text key "Idempotency-Key header value."
    text request_hash "SHA-256 of the canonical request body (IDEMPOTENCY_KEY_REUSED on mismatch)."
    text status "Processing state."
    timestamptz expires_at "Retention end (24 h), purge job."
  }
  markup_rules {
    text id PK "Markup rule id (mkr_ + ULID)."
    text name "Rule name shown in the console."
    jsonb scope "Matching criteria: {origins, destinations, originCountries, destinationCountries, carriers,..."
    text calculation "How the markup is computed."
    int priority "Evaluation order (lower first); first matching non-stackable rule wins."
    boolean is_active "Enabled flag."
  }
  notification_templates {
    text id PK "Template id (ntt_ + ULID)."
    text key "Event key, e.g. booking.confirmed, booking.ticketed, auth.verify_email, auth.password_reset."
    text channel "Delivery channel."
    text locale "Locale of the template (BCP 47)."
  }
  notifications {
    text id PK "Notification id (ntf_ + ULID)."
    text template_id FK "Template used."
    text template_key "Template key (kept if the template is deleted)."
    text channel "Delivery channel."
    text recipient "E-mail address or E.164 phone number."
    text customer_id FK "Customer recipient."
    text booking_id FK "Booking the message is about."
    text status "Delivery state."
    timestamptz next_attempt_at "When the worker may (re)try."
    timestamptz created_at "Enqueue time."
  }
  offer_upsells {
    text id PK "Upsell id (ups_ + ULID)."
    text base_offer_id FK "Offer that was upsold."
    text status "Outcome."
    int result_count "Branded alternatives returned."
    timestamptz expires_at "Expiry of the upsell results."
  }
  payment_events {
    text id PK "Payment event id (pev_ + ULID)."
    text payment_id FK "Payment."
    text type "Event type, e.g. payment.authorized, webhook.charge.refunded."
    timestamptz created_at "Event time."
  }
  payments {
    text id PK "Payment id (pay_ + ULID)."
    text environment "Payment provider environment."
    text checkout_id FK "Checkout that started the payment."
    text booking_id FK "Booking paid (set when the booking exists; post-booking changes too)."
    text customer_id FK "Paying customer (NULL = guest)."
    text provider "Payment service provider."
    text provider_payment_id "PSP payment id (e.g. PaymentIntent id)."
    numeric amount "Amount requested."
    numeric amount_captured "Amount captured."
    numeric amount_refunded "Amount refunded."
    text status "Payment state."
    timestamptz created_at "Creation time."
  }
  priced_offers {
    text id PK "Priced offer id (prc_ + ULID)."
    text environment "Amadeus environment."
    text offer_id FK "Main (first) offer that was priced."
    text parent_priced_offer_id FK "Base priced offer this one re-prices with ancillaries (checkout.setAncillaries); NULL for a..."
    jsonb response "Verbatim pricing response: data.flightOffers, bookingRequirements, included{credit-card-fees..."
    numeric net_total "Priced Amadeus grandTotal (net)."
    numeric selling_total "Total to pay before ancillaries (net + markup + fees)."
    text markup_rule_id FK "Markup rule applied."
    timestamptz expires_at "Expiry (OFFER_EXPIRED; re-price afterwards)."
  }
  queue_snapshots {
    text id PK "Snapshot id (qsn_ + ULID)."
    text environment "Amadeus environment."
    text office_id "officeId queried."
    int queue_id "queue-id path parameter."
    int category "category query parameter (default 0)."
    int item_count "meta.count / number of PNRs returned."
    text supplier_request_id FK "Underlying Amadeus call."
    timestamptz fetched_at "When the queue was read."
  }
  refunds {
    text id PK "Refund id (rfd_ + ULID)."
    text payment_id FK "Refunded payment."
    text booking_id FK "Booking concerned."
    numeric amount "Amount refunded to the customer."
    text reason "Reason."
    text status "Refund state."
  }
  saved_traveler_documents {
    text id PK "Document id (tdc_ + ULID)."
    text saved_traveler_id FK "Saved traveller."
    text document_type "Amadeus documentType."
    text number_last4 "Last 4 characters of the number (display)."
    date expiry_date "Expiry date (validity checks and reminders)."
    char issuance_country "Issuing country (ISO 3166-1 alpha-2)."
  }
  saved_travelers {
    text id PK "Saved traveller id (trv_ + ULID)."
    text customer_id FK "Owning customer."
    text first_name "Given name as on the travel document (Amadeus name.firstName)."
    text last_name "Family name (Amadeus name.lastName)."
    date date_of_birth "Date of birth (drives the traveler type)."
  }
  schema_migrations {
    text id PK "Migration version, e.g. 0001_baseline (lexicographic order = apply order)."
    text status "Outcome in this schema."
    timestamptz created_at "When the migration was applied."
  }
  staff_actions {
    text id PK "Staff action id (sact_ + ULID)."
    text actor_type "Who acted (ConsoleActor.type)."
    text actor_id "stf_ (= staff_id) or key_ (platform.api_keys) id by value; NULL for system and unidentified..."
    text staff_id "platform.tenant_memberships id, by value (NULL for API-key and system actions and failed sig..."
    text action "Action, e.g. booking.cancel, order.patch, booking.issue, pnr.lookup, queue.list."
    text target_type "Affected object type (booking, customer, markup_rule ...)."
    text target_id "Affected object id."
    text booking_id FK "Booking concerned (shortcut for booking timelines)."
    text outcome "Result."
    timestamptz created_at "Action time."
  }
  storefront_settings {
    text id PK "Fixed id: guarantees exactly one row per tenant."
    text brand_name "Brand shown in the storefront and e-mails."
    text default_locale "Default locale (BCP 47)."
    char default_currency "Default selling currency (Amadeus currencyCode)."
    text ticketing_policy "When tickets are issued (issue=true at create-order, after capture, or by staff)."
    boolean auto_issue "True when tickets are issued automatically (derived from ticketing_policy)."
  }
  supplier_requests {
    text id PK "Supplier request id (sreq_ + ULID)."
    text environment "Amadeus environment."
    text operation "Velexis use case / SDK method, e.g. bookings.create."
    text amadeus_api "Amadeus spec (file prefix)."
    text amadeus_operation_id "Amadeus operationId, e.g. createFligtOrders, quoteAirOffers."
    smallint http_status "HTTP status returned (NULL = no response)."
    text outcome "Classified outcome."
    int duration_ms "Latency."
    boolean redacted "True when PII/card data were stripped from the bodies."
    text booking_id FK "Related booking."
    text search_id FK "Related search."
    timestamptz created_at "Call time (retention purge after 90 days)."
  }
  booking_segments |o--o{ booking_ancillaries : "booking_segment_id (cascade)"
  booking_tickets |o--o{ booking_ancillaries : "emd_ticket_id (set null)"
  booking_tickets |o--o{ booking_documents : "booking_ticket_id (set null)"
  booking_tickets |o--o{ booking_tickets : "exchanged_to_ticket_id (set null)"
  booking_travelers |o--o{ booking_ancillaries : "booking_traveler_id (cascade)"
  booking_travelers |o--o{ booking_tickets : "booking_traveler_id (set null)"
  bookings ||--o{ booking_access_tokens : "booking_id (cascade)"
  bookings ||--o{ booking_ancillaries : "booking_id (cascade)"
  bookings ||--o{ booking_associated_records : "booking_id (cascade)"
  bookings ||--o{ booking_contacts : "booking_id (cascade)"
  bookings ||--o{ booking_documents : "booking_id (cascade)"
  bookings ||--o{ booking_events : "booking_id (cascade)"
  bookings ||--o{ booking_remarks : "booking_id (cascade)"
  bookings ||--o{ booking_segments : "booking_id (cascade)"
  bookings ||--o{ booking_tickets : "booking_id (cascade)"
  bookings ||--o{ booking_travelers : "booking_id (cascade)"
  bookings |o--o{ notifications : "booking_id (set null)"
  bookings |o--o{ payments : "booking_id (restrict)"
  bookings |o--o{ refunds : "booking_id (restrict)"
  bookings |o--o{ staff_actions : "booking_id (set null)"
  bookings |o--o{ supplier_requests : "booking_id (set null)"
  checkout_travelers |o--o{ checkout_ancillaries : "checkout_traveler_id (cascade)"
  checkouts |o--o| bookings : "checkout_id (set null)"
  checkouts ||--o{ checkout_ancillaries : "checkout_id (cascade)"
  checkouts ||--o{ checkout_contacts : "checkout_id (cascade)"
  checkouts ||--o{ checkout_remarks : "checkout_id (cascade)"
  checkouts ||--o{ checkout_travelers : "checkout_id (cascade)"
  checkouts |o--o{ payments : "checkout_id (set null)"
  customer_identities |o--o{ customer_sessions : "identity_id (set null)"
  customer_sessions |o--o{ customer_sessions : "replaced_by_id (set null)"
  customers |o--o{ bookings : "customer_id (set null)"
  customers |o--o{ checkouts : "customer_id (set null)"
  customers ||--o{ customer_consents : "customer_id (cascade)"
  customers ||--o{ customer_data_exports : "customer_id (cascade)"
  customers ||--o{ customer_identities : "customer_id (cascade)"
  customers ||--o{ customer_password_resets : "customer_id (cascade)"
  customers ||--o| customer_preferences : "customer_id (cascade)"
  customers ||--o{ customer_sessions : "customer_id (cascade)"
  customers |o--o{ flight_searches : "customer_id (set null)"
  customers |o--o{ notifications : "customer_id (set null)"
  customers |o--o{ payments : "customer_id (set null)"
  customers ||--o{ saved_travelers : "customer_id (cascade)"
  flight_offers ||--o{ offer_upsells : "base_offer_id (cascade)"
  flight_offers ||--o{ priced_offers : "offer_id (cascade)"
  flight_searches |o--o{ flight_offers : "search_id (cascade)"
  flight_searches |o--o{ supplier_requests : "search_id (set null)"
  markup_rules |o--o{ bookings : "markup_rule_id (set null)"
  markup_rules |o--o{ flight_offers : "markup_rule_id (set null)"
  markup_rules |o--o{ priced_offers : "markup_rule_id (set null)"
  notification_templates |o--o{ notifications : "template_id (set null)"
  offer_upsells |o--o{ flight_offers : "upsell_id (cascade)"
  payments ||--o{ payment_events : "payment_id (cascade)"
  payments ||--o{ refunds : "payment_id (restrict)"
  priced_offers |o--o{ bookings : "priced_offer_id (set null)"
  priced_offers ||--o{ checkouts : "base_priced_offer_id (restrict)"
  priced_offers ||--o{ checkouts : "priced_offer_id (restrict)"
  priced_offers |o--o{ priced_offers : "parent_priced_offer_id (set null)"
  saved_travelers |o--o{ booking_travelers : "saved_traveler_id (set null)"
  saved_travelers |o--o{ checkout_travelers : "saved_traveler_id (set null)"
  saved_travelers ||--o{ saved_traveler_documents : "saved_traveler_id (cascade)"
  supplier_requests |o--o{ booking_events : "supplier_request_id (set null)"
  supplier_requests |o--o{ queue_snapshots : "supplier_request_id (set null)"
