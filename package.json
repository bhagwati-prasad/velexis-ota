{
  "name": "velexis",
  "version": "0.0.0",
  "private": true,
  "description": "Velexis multi-tenant OTA platform: platform and OTA components, JS SDK, shared packages and deployment files.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int --concurrency=1",
    "test:e2e": "pnpm --filter @velexis/e2e run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contracts:lint": "turbo run contracts:lint",
    "contracts:generate": "turbo run generate",
    "db:migrate": "pnpm --filter @velexis/db run migrate",
    "db:migrate:tenants": "pnpm --filter @velexis/db run migrate:tenants",
    "db:codegen": "pnpm --filter @velexis/db run codegen",
    "db:seed:reference": "pnpm --filter @velexis/reference-data run load",
    "dev:keys": "node tools/dev/dev-keys.mjs",
    "stub:amadeus": "pnpm --filter @velexis/amadeus-stub run start",
    "plan:lint": "node tools/plan-lint/plan-lint.mjs",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "15.5.26",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "globals": "16.5.0",
    "prettier": "3.9.9",
    "turbo": "2.11.4",
    "typescript": "5.6.3",
    "typescript-eslint": "8.70.1",
    "vitest": "3.2.7"
  }
}
