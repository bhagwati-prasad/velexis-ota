{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Type-checks the end-to-end harness, its specs and unit tests (pnpm typecheck); Playwright compiles the files itself, so nothing is emitted.",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "noEmit": true,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  },
  "include": ["playwright.config.ts", "support/**/*.ts", "specs/**/*.ts", "test/**/*.ts"]
}
