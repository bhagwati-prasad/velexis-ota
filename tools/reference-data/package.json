{
  "name": "@velexis/reference-data",
  "version": "0.0.0",
  "private": true,
  "description": "Vendored reference datasets (currencies, countries, time zones, cities, airports, airlines, aircraft) from OpenTravelData and Unicode CLDR, their fetch and validation scripts, and the loader that upserts them into the reference schema (ADR-0024).",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/load.js",
  "types": "./dist/load.d.ts",
  "exports": {
    ".": {
      "types": "./dist/load.d.ts",
      "default": "./dist/load.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/tsconfig.tsbuildinfo",
    "data",
    "SOURCES.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "lint": "eslint .",
    "test": "vitest run",
    "test:int": "vitest run --mode integration",
    "load": "node dist/cli/load.js --data data",
    "fetch": "node scripts/fetch.mjs",
    "check": "node scripts/fetch.mjs --check",
    "validate": "node scripts/validate.mjs",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@velexis/config": "workspace:*",
    "@velexis/logger": "workspace:*",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@velexis/db": "workspace:*",
    "eslint": "9.39.5",
    "typescript": "5.6.3",
    "vitest": "3.2.7"
  }
}
