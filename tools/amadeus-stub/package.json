{
  "name": "@velexis/amadeus-stub",
  "version": "0.0.0",
  "private": true,
  "description": "Amadeus stub server for development and tests (ADR-0015): the OAuth token endpoint and the 12 Amadeus operations on a plain Node http server, served from synthetic or scrubbed fixtures, with scenarios and request validation against docs/amadeus-api; records scrubbed fixtures from the Amadeus test environment (record). devDependency only (ADR-0022).",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/tsconfig.tsbuildinfo",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "lint": "eslint .",
    "test": "vitest run",
    "start": "tsc -b && node dist/cli.js",
    "record": "tsc -b && node dist/cli.js record",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@velexis/config": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "5.6.3",
    "vitest": "3.2.7"
  }
}
