# velexis-log-review.service — the automated review of the security logs (task X-038; PCI DSS 10.4.1, 10.4.1.1, 10.4.2,
# 11.5), started every hour by velexis-log-review.timer. Runs the root-owned copy of deploy/scripts/log-review.sh
# installed as /usr/local/sbin/velexis-logreview: an immediate alert, through velexis-alert, for a root login, a new SSH
# key, a change under /etc/velexis/keys, an AIDE change outside a deploy, a failing or late log shipment, a burst of
# refused outbound connections and a security log folder above 5 GB; and once a day (the first run at or after 06:00
# UTC) the summary of the last 24 hours. It exits 1 only when an alert or the summary could not be sent (the next run
# sends it again), and then OnFailure= reports the unit itself.
# Docs: docs/mvp/deployment-single-vm.md §12 and §13. Test: deploy/scripts/test/log-review.test.sh.
[Unit]
Description=Velexis security log review (immediate alerts every hour, a summary every day)
Wants=network-online.target
After=network-online.target
OnFailure=velexis-alert@%n.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/velexis-logreview
# A day of security entries (the summary) takes a minute or two on a busy day.
TimeoutStartSec=20min
SyslogIdentifier=velexis-log-review
LimitCORE=0
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# The cursor, the known SSH keys, the last AIDE report, the checks' states, the day of the last summary and the lock.
StateDirectory=velexis/log-review
StateDirectoryMode=0700

# Sandboxing, as velexis-healthcheck, with one capability: CAP_DAC_READ_SEARCH, to read AIDE's log (owner _aide) and
# every account's ~/.ssh/authorized_keys (the new-key check), which root does not own. Home folders stay read-only. The
# network is used for SMTP (velexis-alert, which it runs for its alerts).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0077
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
