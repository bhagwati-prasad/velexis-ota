# velexis-healthcheck.service — the on-VM health check (ADR-0016 "On-VM check", task X-030), started every 5 minutes
# by velexis-healthcheck.timer. Runs the root-owned copy of deploy/scripts/healthcheck.sh installed as
# /usr/local/sbin/velexis-healthcheck: unit readiness, failed and waiting jobs, disk, Redis memory, backup age, TLS
# expiry and, once a day, the payment pages against the release's inventory. It alerts through velexis-alert only when
# a check changes (state files in /var/lib/velexis/healthcheck/) and exits 0 whatever the checks find; it exits 1 only
# when an alert could not be sent (retried by the next run), and then OnFailure= reports the unit itself.
# Docs: docs/mvp/deployment-single-vm.md §13. Test: deploy/scripts/test/healthcheck.test.sh.
[Unit]
Description=Velexis on-VM health check (units, jobs, disk, Redis memory, backup age, TLS expiry, payment pages)
Wants=network-online.target
After=network-online.target
OnFailure=velexis-alert@%n.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/velexis-healthcheck
# The run takes a few seconds; the payment page check adds about twenty local HTTPS requests once a day.
TimeoutStartSec=4min
SyslogIdentifier=velexis-healthcheck
LimitCORE=0
Nice=5
# The only folder it writes: one state file per check, the day of the last payment page check and its lock.
StateDirectory=velexis/healthcheck
StateDirectoryMode=0700

# Sandboxing, as velexis-alert@ (which it runs for its alerts). Root only to read root-only files without any
# capability: /etc/velexis/.provision-secrets (the Redis password), caddy.env and backup.env (names read without
# sourcing them), healthcheck.env, alert.env (read by velexis-alert), the release's inventory and the backup marker.
# The file system is read-only but for the state folder; the network is used for 127.0.0.1 (health ports, Redis,
# this VM's Caddy) and for SMTP. /proc/locks (velexis-deploy's lock) stays readable: no ProcSubset=pid.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
