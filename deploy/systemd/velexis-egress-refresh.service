# velexis-egress-refresh.service — the VM's outbound allow-list (task X-041; PCI DSS 11.5.1.1). Runs the root-owned copy
# of deploy/scripts/egress.sh installed as /usr/local/sbin/velexis-egress: it loads or repairs the nftables table
# inet velexis_egress (outgoing connections denied by default, every refusal logged with the prefix VELEXIS-EGRESS-DENY)
# and refreshes its address sets from /etc/velexis/egress/allowed-hosts.conf through the VM's resolvers, keeping the
# last good addresses of a host whose lookup fails. It runs at boot, before network-online.target, so the table is in
# place before the Velexis units, Caddy and the timers that reach out start (nftables rules do not survive a reboot),
# and every 2 minutes from velexis-egress-refresh.timer. provision-vm.sh --steps egress enables both.
# A failed run leaves the table as it was; OnFailure= mails once per run of failures (--alert-once).
# Docs: docs/mvp/runbooks/outbound-allow-list.md. Test: deploy/scripts/test/check-vm.test.sh.
[Unit]
Description=Velexis outbound allow-list (nftables table inet velexis_egress)
DefaultDependencies=no
After=local-fs.target network.target nss-lookup.target
Before=network-online.target shutdown.target
Conflicts=shutdown.target
OnFailure=velexis-alert@%n.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/velexis-egress refresh --alert-once
# Each lookup takes 10 s at most and they run at once; nft loads the table in one transaction.
TimeoutStartSec=90s
SyslogIdentifier=velexis-egress
LimitCORE=0
# The addresses of every line with the time a lookup last returned them, the failure marker and the run lock.
StateDirectory=velexis/egress
StateDirectoryMode=0700

# Sandboxing. Root with CAP_NET_ADMIN only, for nft (netlink); the network for the lookups (systemd-resolved over its
# unix socket) and chronyc (its socket in /run/chrony, else UDP to 127.0.0.1:323). The file system is read-only but the
# state folder and /run/chrony. The kernel still loads the nftables modules the table needs on its own.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-/run/chrony
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0077
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
# network-online.target: the Velexis units and Caddy want it, and it waits for this run. multi-user.target: the table
# also loads at a boot that pulls nothing into network-online.target.
WantedBy=network-online.target multi-user.target
