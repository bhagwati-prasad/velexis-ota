# velexis-ota-worker.service — template from deploy/systemd/, installed to /etc/systemd/system/ by deploy.sh.
# Docs: docs/mvp/deployment-single-vm.md §4, docs/mvp/adr/0007-single-vm-without-docker.md,
# docs/mvp/adr/0026-system-users-per-trust-zone.md (one system user per trust zone).
# Health: /health/ready on HEALTH_PORT (polled by deploy.sh after every restart; docs/mvp/adr/0016-observability.md).
[Unit]
Description=Velexis OTA backend worker (ota/backend dist/worker.js, health 127.0.0.1:4001)
Documentation=file:///srv/velexis/current/deploy/README.md
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target postgresql.service redis-server.service
OnFailure=velexis-alert@%n.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=velexis-ota
Group=velexis-ota
# Read access to the release (root:velexis, u=rX,g=rX,o=); the group grants nothing else (ADR-0026).
SupplementaryGroups=velexis
WorkingDirectory=/srv/velexis/current/ota-backend
EnvironmentFile=/etc/velexis/ota-backend.env
EnvironmentFile=/etc/velexis/ota-worker.env
Environment=NODE_ENV=production
Environment=HEALTH_PORT=4001
Environment=NODE_OPTIONS=--max-old-space-size=400
ExecStart=/usr/bin/node --enable-source-maps dist/worker.js
Restart=always
RestartSec=3
# Auto-restarts skip the failed state (systemd 254+): OnFailure= mails one alert when the start limit of [Unit]
# gives up (StartLimitBurst=10 within StartLimitIntervalSec=300), not one per crash. Crashes stay in the journal.
RestartMode=direct
KillSignal=SIGTERM
TimeoutStopSec=60
SyslogIdentifier=velexis-ota-worker

# Resources (memory budget: docs/mvp/architecture.md §3). No core dumps: card data must never reach disk.
MemoryMax=512M
LimitNOFILE=65536
LimitCORE=0

# Sandboxing. The boundary between the apps is the OS user (ADR-0026): each trust zone runs as its own system
# user, so this process cannot read another zone's /proc/<pid>/environ or reach its files through /proc/<pid>/root,
# ProtectProc=invisible hides the other users' processes, env files are root:root 0600 (systemd reads them before it
# starts the unit) and each key folder belongs to its zone's user. InaccessiblePaths= below is defence in depth only.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
# MemoryDenyWriteExecute is deliberately NOT set: the V8 JIT needs writable+executable memory.
# ProcSubset=pid is deliberately NOT set: it hides /proc/stat, and os.cpus() then returns nothing (units-smoke.sh).
# Document storage: /var/lib/velexis/storage, owned by velexis-ota with mode 0700 (ADR-0017, ADR-0026).
ReadWritePaths=/var/lib/velexis/storage
# Defence in depth (ADR-0026): hide the platform zone's key folder, the other zones' env files and root's files
# from this unit's mount namespace. It does not stop a process of the same user, and nothing stops root.
InaccessiblePaths=-/etc/velexis/keys/platform -/etc/velexis/platform-backend.env -/etc/velexis/platform-worker.env
InaccessiblePaths=-/etc/velexis/platform-frontend.env -/etc/velexis/platform-admin.env -/etc/velexis/ota-admin.env
InaccessiblePaths=-/etc/velexis/migrator.env -/etc/velexis/reference-loader.env -/etc/velexis/.provision-secrets
InaccessiblePaths=-/etc/velexis/caddy.env -/etc/velexis/backup.env -/etc/velexis/alert.env -/etc/velexis/backup

[Install]
WantedBy=multi-user.target
