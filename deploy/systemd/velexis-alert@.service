# velexis-alert@.service — sends an e-mail when a unit enters the failed state (ADR-0016).
# Every Velexis unit has OnFailure=velexis-alert@%n.service; %i is the failed unit's name.
# Runs the root-owned copy of deploy/scripts/alert.sh installed as /usr/local/sbin/velexis-alert.
# deploy/systemd/test/units-smoke.sh runs this unit for real: a unit killed into failed mails Mailpit.
[Unit]
Description=Velexis failure alert for %i

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/velexis/alert.env
ExecStart=/usr/local/sbin/velexis-alert unit-failed %i
TimeoutStartSec=2min
SyslogIdentifier=velexis-alert
LimitCORE=0

# Sandboxing. Root only to read the system journal and the unit's status from systemd, with no capabilities;
# the file system is read-only and the network is used for SMTP only.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
