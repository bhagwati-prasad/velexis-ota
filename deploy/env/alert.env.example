# /etc/velexis/alert.env — settings of alert.sh (velexis-alert@.service, backup and health-check failures).
# Owner root:root, mode 0600. alert.sh sends plain-text mail with curl over SMTP; no MTA on the VM.
ALERT_SMTP_URL=smtps://smtp.example.com:465
ALERT_SMTP_USER=CHANGE_ME
ALERT_SMTP_PASSWORD=CHANGE_ME
ALERT_FROM=alerts@mail.platform.example.com
ALERT_TO=ops@example.com
# Short name of this machine in subjects, e.g. "velexis-prod-1".
ALERT_HOST_LABEL=velexis-vm
