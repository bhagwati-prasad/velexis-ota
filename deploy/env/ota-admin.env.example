# /etc/velexis/ota-admin.env — OTA admin (velexis-ota-admin, Next.js standalone on 127.0.0.1:3002).
# Owner root:root, mode 0600: systemd reads it before it starts the unit as velexis-ota-admin (ADR-0026). The OTA
# admin calls the OTA API server side through the SDK with its service key; staff tokens live in __Host- httpOnly
# cookies (ADR-0008). Read by ota/admin/src/config.ts; PORT (3002) and HOSTNAME (127.0.0.1) come from the unit, not
# from this file. Never add a NEXT_PUBLIC_ variable.

APP_ENV=production
LOG_LEVEL=info
PUBLIC_OTA_ADMIN_URL=https://admin.ota.example.com
PUBLIC_PORTAL_URL=https://platform.example.com
# OTA API over loopback (never through Caddy): the backend accepts the service key only on a direct connection.
OTA_API_URL=http://127.0.0.1:4000
# Generated once by provision-vm.sh (sk_svc_…); the same value as in ota-backend.env.
OTA_ADMIN_SERVICE_KEY=@@OTA_ADMIN_SERVICE_KEY@@
SENTRY_DSN=
