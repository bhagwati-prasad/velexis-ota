# /etc/velexis/backup.env — settings of velexis-backup.service and restore.sh. Owner root:root, mode 0600.
# Design: docs/mvp/deployment-single-vm.md §10 and §11, ADR-0007 (Backups).

# Local staging directory for the encrypted files before upload (root 0700).
BACKUP_DIR=/var/backups/velexis
# age public keys (age1..., one per line; comments allowed). The PRIVATE keys are never on the VM: they are kept
# offline by the developer, and backup.sh refuses to run while a private age key is in a recipients file or anywhere
# in /etc/velexis.
#   data:   database dump, roles, storage tar, Redis AOF
#   config: /etc/velexis (master key, env files) — a DIFFERENT key, so one stolen backup never holds data + key.
#           backup.sh refuses to run when the two files share a key.
AGE_RECIPIENTS_FILE=/etc/velexis/backup/data-recipients.txt
AGE_CONFIG_RECIPIENTS_FILE=/etc/velexis/backup/config-recipients.txt
# rclone remote (S3-compatible bucket at ANOTHER provider), configured in RCLONE_CONFIG ([offsite], type s3, with
# no_check_bucket = true because the key may not create buckets). The bucket has versioning, object lock (default
# retention 14 days) and lifecycle rules (daily/ expires after 14 days, monthly/ after 186 days, noncurrent versions
# after 1 day, incomplete multipart uploads after 1 day); the key in rclone.conf may put, list and read objects but
# has NO delete permission (DeleteObject, DeleteObjectVersion), and backup.sh never removes anything remotely.
RCLONE_CONFIG=/etc/velexis/backup/rclone.conf
RCLONE_REMOTE=offsite:velexis-backups-CHANGE_ME
# Local copies are kept 2 days (only the <UTC stamp> set folders in BACKUP_DIR are pruned).
RETENTION_LOCAL_DAYS=2
# Database and services.
PG_DATABASE=velexis
REDIS_AOF_DIR=/var/lib/redis/appendonlydir
REDIS_PASSWORD=@@REDIS_PASSWORD@@
STORAGE_DIR=/var/lib/velexis/storage
# Written after every successful run; the health check alerts when it is older than 26 hours (ADR-0016).
BACKUP_MARKER_FILE=/var/lib/velexis/backup-last-success
# Never set on the VM: CONFIG_DIR, PG_RUNAS, SKIP_REDIS, CONFIG_RESTORE_DIR, LOG_DIR and SYSTEMCTL move the scripts
# off the VM's paths and tools for deploy/scripts/test/backup-restore.test.sh (see the headers of backup.sh and
# restore.sh).
