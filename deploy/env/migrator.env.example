# /etc/velexis/migrator.env — used ONLY by velexis-deploy (deploy.sh) to run the platform, reference and tenant
# migrations. Owner root:root, mode 0600. systemd reads it for a transient unit with a dynamic user (systemd-run
# -p DynamicUser=yes -p EnvironmentFile=...), so the DSN never reaches a process that an app user owns, the
# environment of velexis-deploy itself or a command line (ADR-0026). No app unit can read it (InaccessiblePaths=).
# Role velexis_migrator: DDL only. The tenant fan-out runs as velexis_migrator with SET LOCAL ROLE
# velexis_provisioner, so tenant objects stay owned by the provisioner role (ADR-0004).
# One DSN per one-off process: the reference data loader has its own file, reference-loader.env.
DATABASE_MIGRATOR_URL=postgres://velexis_migrator:@@MIGRATOR_DB_PASSWORD@@@127.0.0.1:5432/velexis
# Tenant fan-out on deploy (ADR-0005): schemas migrated in parallel, and the failure ratio that halts the rollout.
# velexis-deploy reads these two values (never the DSN) and passes them to migrate.js as flags.
MIGRATE_TENANT_CONCURRENCY=4
MIGRATE_TENANT_MAX_FAILURE_RATIO=0.1
