# /etc/velexis/migrator.env — used ONLY by deploy.sh (as root) to run platform, reference and tenant migrations.
# Owner root:root, mode 0600. No app unit can read it (InaccessiblePaths=). Role velexis_migrator: DDL only.
DATABASE_MIGRATOR_URL=postgres://velexis_migrator:@@MIGRATOR_DB_PASSWORD@@@127.0.0.1:5432/velexis
# Tenant fan-out on deploy (ADR-0005): schemas migrated in parallel, and the failure ratio that halts the rollout.
MIGRATE_TENANT_CONCURRENCY=4
MIGRATE_TENANT_MAX_FAILURE_RATIO=0.1
# Reference data loader (tools/reference-data) runs with the platform role (DML on reference).
REFERENCE_DATABASE_URL=postgres://velexis_platform_app:@@PLATFORM_DB_PASSWORD@@@127.0.0.1:5432/velexis
