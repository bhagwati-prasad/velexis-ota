# /etc/velexis/platform-worker.env — OPTIONAL overrides for velexis-platform-worker only (loaded after
# platform-backend.env; the unit ignores the file when it is missing). Owner root:root, mode 0600 (ADR-0026).
# Example: lower the log level of the worker without touching the API.
# LOG_LEVEL=info
# Never override MAX_TENANTS_PER_ACCOUNT or the FEATURE_* switches here: the worker must see the values of
# platform-backend.env, so the schedulers of a feature and its endpoints are on or off together (PADR-0015).
