# /etc/velexis/caddy.env — environment of caddy.service (drop-in deploy/systemd/caddy.service.d/velexis.conf).
# Owner root:caddy, mode 0640. Used by deploy/caddy/Caddyfile.

# Base domains: the placeholders of decisions.md §4. Replace with the real domains on the VM.
PLATFORM_BASE_DOMAIN=platform.example.com
STOREFRONT_BASE_DOMAIN=ota.example.com
# Let's Encrypt / ZeroSSL account e-mail (expiry notices).
ACME_EMAIL=ops@example.com
# Storefront edge credential sent to the OTA API on /api/* (same value as in ota-backend.env; ADR-0018).
VELEXIS_EDGE_SECRET=@@EDGE_SECRET@@
