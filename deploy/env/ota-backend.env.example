# /etc/velexis/ota-backend.env — OTA backend API AND worker (velexis-ota-api, velexis-ota-worker).
# Owner root:root, mode 0600: systemd reads it before it starts both units as velexis-ota (ADR-0026). Created from
# this template by provision-vm.sh; @@...@@ values are generated there, CHANGE_ME values are filled in by the
# developer. Matrix: docs/mvp/architecture.md §6.
# A variable added here must be added to the VM's file before the next deploy (an empty value is fine): velexis-deploy
# refuses a release until it exists, and check-vm.sh and provision-vm.sh --steps envfiles name what is missing.
# PORT (4000) and HEALTH_PORT (4001) are set in the unit files. The provisioner DSN is only in ota-worker.env; the
# migrator DSN is only in migrator.env, which no app process ever gets.

# Runtime
APP_ENV=production
LOG_LEVEL=info
# API only: the proxies whose X-Forwarded-For is believed (Express trust proxy). Caddy runs on this VM: loopback.
TRUST_PROXY=loopback

# PostgreSQL: role velexis_ota_app (DML on tenant schemas, SELECT on reference, SELECT on selected platform tables).
DATABASE_URL=postgres://velexis_ota_app:@@OTA_DB_PASSWORD@@@127.0.0.1:5432/velexis
REDIS_URL=redis://:@@REDIS_PASSWORD@@@127.0.0.1:6379/0

# Key files in the OTA zone's folder /etc/velexis/keys/ota (velexis-ota, folder 0500, files 0400), generated by
# provision-vm.sh (ADR-0010, ADR-0026). master-v1.key and api-key-pepper are identical copies of the files in
# /etc/velexis/keys/platform; the OTA backend's own Ed25519 signing key and the document URL key exist only here.
MASTER_KEY_DIR=/etc/velexis/keys/ota
MASTER_KEY_CURRENT=local:v1
API_KEY_PEPPER_FILE=/etc/velexis/keys/ota/api-key-pepper
JWT_PRIVATE_KEY_FILE=/etc/velexis/keys/ota/ota-jwt-ed25519.pem
DOCUMENT_URL_KEY_FILE=/etc/velexis/keys/ota/document-url.key

# E-mail (customer and booking e-mails are sent from the Velexis-controlled sending domain; ADR-0017). Worker only:
# the worker sends from MAIL_FROM's address with the OTA's brand name as the display name (OADR-0013 item 5).
SMTP_URL=smtps://CHANGE_ME_USER:CHANGE_ME_PASSWORD@smtp.example.com:465
MAIL_FROM="Velexis OTA <no-reply@mail.ota.example.com>"
# Worker only: the Velexis ops address of the OTA backend's operational alerts, one plain address.
OPS_ALERT_EMAIL=CHANGE_ME_ops@example.com

# Public URLs and the storefront base domain (the API refuses to start without them: an http(s) URL, and a lower-case
# host name whose sub-domains <key>.ota.example.com are the tenants' storefronts; the worker builds the links of the
# OTAs' e-mails on them).
PUBLIC_OTA_API_URL=https://api.ota.example.com
STOREFRONT_BASE_DOMAIN=ota.example.com
# Worker only: the OTA admin's public base URL, for the links of staff alert e-mails.
PUBLIC_OTA_ADMIN_URL=https://admin.ota.example.com

# First-party credentials (ADR-0008, ADR-0018). The same values are in ota-admin.env and caddy.env. The API compares
# X-Velexis-Edge with VELEXIS_EDGE_SECRET in constant time (OADR-0009) and refuses to start without it.
OTA_ADMIN_SERVICE_KEY=@@OTA_ADMIN_SERVICE_KEY@@
VELEXIS_EDGE_SECRET=@@EDGE_SECRET@@

# Stripe, Velexis account, customer payments in "velexis" mode (M3). Live keys only after the M6 launch checklist.
# Each pair is used only when both keys are set: sk_test_ (or a restricted rk_test_) with pk_test_, and the same with
# _live_. A key of the other mode or kind stops the API at start-up. Empty: card payments of "velexis" connections
# answer 424 PAYMENT_PROVIDER_NOT_CONFIGURED and the storefront offers no payment method in that environment.
STRIPE_SECRET_KEY_TEST=
STRIPE_PUBLISHABLE_KEY_TEST=
STRIPE_SECRET_KEY_LIVE=
STRIPE_PUBLISHABLE_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_VELEXIS_TEST=
STRIPE_WEBHOOK_SECRET_VELEXIS_LIVE=
# Connect webhooks (M5).
STRIPE_WEBHOOK_SECRET_CONNECT_TEST=
STRIPE_WEBHOOK_SECRET_CONNECT_LIVE=

# Amadeus base URLs: optional overrides; empty means the official test and production endpoints.
# Credentials are NOT here: they are stored encrypted in platform.amadeus_accounts (ADR-0012).
AMADEUS_BASE_URL_TEST=
AMADEUS_BASE_URL_LIVE=

# Global kill switch for the airline-card payment method (ADR-0011). Stays false until the M6 PCI review.
AIRLINE_CARD_ENABLED=false

# Storage adapter (ADR-0017). The folder is velexis-ota's, mode 0700 (provision-vm.sh).
STORAGE_DRIVER=local
STORAGE_DIR=/var/lib/velexis/storage

SENTRY_DSN=
