# /etc/velexis/ota-backend.env — OTA backend API AND worker (velexis-ota-api, velexis-ota-worker).
# Owner root:velexis, mode 0640. Created from this template by provision-vm.sh; @@...@@ values are generated there,
# CHANGE_ME values are filled in by the developer. Matrix: docs/mvp/architecture.md §6.
# PORT (4000) and HEALTH_PORT (4001) are set in the unit files. The migrator DSN is only in ota-worker.env.

# Runtime
APP_ENV=production
LOG_LEVEL=info

# PostgreSQL: role velexis_ota_app (DML on tenant schemas, SELECT on reference, SELECT on selected platform tables).
DATABASE_URL=postgres://velexis_ota_app:@@OTA_DB_PASSWORD@@@127.0.0.1:5432/velexis
REDIS_URL=redis://:@@REDIS_PASSWORD@@@127.0.0.1:6379/0

# Key files (ADR-0010). The OTA backend has its own Ed25519 signing key; the pepper is shared with the platform.
MASTER_KEY_DIR=/etc/velexis/keys
MASTER_KEY_CURRENT=local:v1
API_KEY_PEPPER_FILE=/etc/velexis/keys/api-key-pepper
JWT_PRIVATE_KEY_FILE=/etc/velexis/keys/ota-jwt-ed25519.pem
DOCUMENT_URL_KEY_FILE=/etc/velexis/keys/document-url.key

# E-mail (customer and booking e-mails are sent from the Velexis-controlled sending domain; ADR-0017).
SMTP_URL=smtps://CHANGE_ME_USER:CHANGE_ME_PASSWORD@smtp.example.com:465
MAIL_FROM="Velexis OTA <no-reply@mail.ota.example.com>"

# Public URLs and the storefront base domain.
PUBLIC_OTA_API_URL=https://api.ota.example.com
STOREFRONT_BASE_DOMAIN=ota.example.com

# First-party credentials (ADR-0008, ADR-0018). The same values are in ota-admin.env and caddy.env.
OTA_ADMIN_SERVICE_KEY=@@OTA_ADMIN_SERVICE_KEY@@
VELEXIS_EDGE_SECRET=@@EDGE_SECRET@@

# Stripe, Velexis account, customer payments in "velexis" mode (M3). Live keys only after the M6 launch checklist.
STRIPE_SECRET_KEY_TEST=
STRIPE_PUBLISHABLE_KEY_TEST=
STRIPE_SECRET_KEY_LIVE=
STRIPE_PUBLISHABLE_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_VELEXIS_TEST=
STRIPE_WEBHOOK_SECRET_VELEXIS_LIVE=
# Connect webhooks (M5).
STRIPE_WEBHOOK_SECRET_CONNECT_TEST=
STRIPE_WEBHOOK_SECRET_CONNECT_LIVE=

# Amadeus base URLs: optional overrides; empty means the official test and production endpoints.
# Credentials are NOT here: they are stored encrypted in platform.amadeus_accounts (ADR-0012).
AMADEUS_BASE_URL_TEST=
AMADEUS_BASE_URL_LIVE=

# Global kill switch for the airline-card payment method (ADR-0011). Stays false until the M6 PCI review.
AIRLINE_CARD_ENABLED=false

# Storage adapter (ADR-0017).
STORAGE_DRIVER=local
STORAGE_DIR=/var/lib/velexis/storage

SENTRY_DSN=
