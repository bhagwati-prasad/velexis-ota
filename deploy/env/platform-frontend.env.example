# /etc/velexis/platform-frontend.env — portal (velexis-portal, Next.js standalone on 127.0.0.1:3000).
# Owner root:velexis, mode 0640. The portal holds no keys: it calls the platform API server side and keeps
# session tokens in __Host- httpOnly cookies (ADR-0008). Never add a NEXT_PUBLIC_ variable with a secret.

APP_ENV=production
LOG_LEVEL=info
PUBLIC_PORTAL_URL=https://platform.example.com
PUBLIC_OTA_ADMIN_URL=https://admin.ota.example.com
STOREFRONT_BASE_DOMAIN=ota.example.com
# Platform API over loopback (never through Caddy).
PLATFORM_API_URL=http://127.0.0.1:3100
SENTRY_DSN=
