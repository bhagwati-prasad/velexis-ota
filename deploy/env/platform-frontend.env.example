# /etc/velexis/platform-frontend.env — portal (velexis-portal, Next.js standalone on 127.0.0.1:3000).
# Owner root:root, mode 0600: systemd reads it before it starts the unit as velexis-portal (ADR-0026). The portal
# holds no key files: it calls the platform API server side and keeps session tokens in __Host- httpOnly cookies
# (ADR-0008). Its only secret is PLATFORM_BFF_KEY. Created from this template by provision-vm.sh; @@...@@ values
# are generated there. Never add a NEXT_PUBLIC_ variable with a secret.

APP_ENV=production
LOG_LEVEL=info
PUBLIC_PORTAL_URL=https://platform.example.com
PUBLIC_OTA_ADMIN_URL=https://admin.ota.example.com
STOREFRONT_BASE_DOMAIN=ota.example.com
# Platform API over loopback (never through Caddy).
PLATFORM_API_URL=http://127.0.0.1:3100
# First-party key shared with the platform API and the platform admin (PADR-0019): lets the portal forward the
# visitor's IP and user agent to the API. Generated once by provision-vm.sh; the same value in all three env files.
PLATFORM_BFF_KEY=@@PLATFORM_BFF_KEY@@
SENTRY_DSN=
