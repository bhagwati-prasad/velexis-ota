# /etc/velexis/platform-admin.env — platform admin (velexis-platform-admin, Next.js standalone on 127.0.0.1:3001).
# Owner root:root, mode 0600: systemd reads it before it starts the unit as velexis-platform-admin (ADR-0026).
# MFA is mandatory for every platform admin account (ADR-0008). The admin holds no key files: it calls the platform
# API server side and keeps session tokens in __Host- httpOnly cookies. Its only secret is PLATFORM_BFF_KEY.
# Created from this template by provision-vm.sh; @@...@@ values are generated there. Never add a NEXT_PUBLIC_
# variable with a secret.

APP_ENV=production
LOG_LEVEL=info
PUBLIC_PLATFORM_ADMIN_URL=https://admin.platform.example.com
# Portal origin: the "enable MFA in the portal" link of MFA_REQUIRED (PAD-001, platform/admin/README.md).
PUBLIC_PORTAL_URL=https://platform.example.com
# Platform API over loopback (never through Caddy).
PLATFORM_API_URL=http://127.0.0.1:3100
# First-party key shared with the platform API and the portal (PADR-0019): lets the admin forward the admin's IP
# and user agent to the API. Generated once by provision-vm.sh; the same value in all three env files.
PLATFORM_BFF_KEY=@@PLATFORM_BFF_KEY@@
SENTRY_DSN=
