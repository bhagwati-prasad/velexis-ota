# /etc/velexis/platform-backend.env — platform backend API AND worker (velexis-platform-api, velexis-platform-worker).
# Owner root:root, mode 0600: systemd reads it before it starts both units as velexis-platform (ADR-0026). Created
# from this template by provision-vm.sh; @@...@@ values are generated there, CHANGE_ME values are filled in by the
# developer. Never commit the real file. Matrix: docs/mvp/architecture.md §6.
# PORT (3100) and HEALTH_PORT (3101) are set in the unit files, not here.

# Runtime
APP_ENV=production
LOG_LEVEL=info

# PostgreSQL: role velexis_platform_app (DML on platform and reference, nothing on tenant schemas).
DATABASE_URL=postgres://velexis_platform_app:@@PLATFORM_DB_PASSWORD@@@127.0.0.1:5432/velexis
# Redis 7 on loopback (BullMQ prefix vx, caches with TTL, portal-token handoff ptk:*).
REDIS_URL=redis://:@@REDIS_PASSWORD@@@127.0.0.1:6379/0

# Key files in the platform zone's folder /etc/velexis/keys/platform (velexis-platform, folder 0500, files 0400),
# generated by provision-vm.sh (ADR-0010, ADR-0026). master-v1.key and api-key-pepper are identical copies of the
# files in /etc/velexis/keys/ota; the JWT key exists only here.
MASTER_KEY_DIR=/etc/velexis/keys/platform
MASTER_KEY_CURRENT=local:v1
API_KEY_PEPPER_FILE=/etc/velexis/keys/platform/api-key-pepper
JWT_PRIVATE_KEY_FILE=/etc/velexis/keys/platform/platform-jwt-ed25519.pem
# No DOCUMENT_URL_KEY_FILE: signed document URLs are OTA-only (ADR-0010); the key is only in the OTA zone's folder.

# E-mail through the transactional SMTP provider (ADR-0017). Credentials are part of the URL.
SMTP_URL=smtps://CHANGE_ME_USER:CHANGE_ME_PASSWORD@smtp.example.com:465
MAIL_FROM="Velexis <no-reply@mail.platform.example.com>"

# Public URLs (placeholder hosts of decisions.md §4; replace with the real ones on the VM).
PUBLIC_PORTAL_URL=https://platform.example.com
PUBLIC_PLATFORM_ADMIN_URL=https://admin.platform.example.com
PUBLIC_OTA_ADMIN_URL=https://admin.ota.example.com
STOREFRONT_BASE_DOMAIN=ota.example.com

# Stripe, Velexis account, subscription billing (M5). Leave empty until M5; the app then keeps billing manual.
STRIPE_SECRET_KEY=
STRIPE_BILLING_WEBHOOK_SECRET=
# Stripe Connect Standard OAuth client id (M5).
STRIPE_CONNECT_CLIENT_ID=
# Signing secret of /webhooks/stripe/connect-accounts (account.updated, account.application.deauthorized; PADR-0011).
# Required by @velexis/config when FEATURE_OWN_STRIPE is on (M5).
STRIPE_CONNECT_WEBHOOK_SECRET=

# Amadeus base URLs: optional overrides; empty means the official test and production endpoints. The platform
# worker only requests OAuth tokens to verify credentials (ADR-0012); flight operations are OTA-backend-only.
AMADEUS_BASE_URL_TEST=
AMADEUS_BASE_URL_LIVE=

# Storage adapter (ADR-0017). Reserved: not read by the platform in the MVP (CSV exports are streamed). The folder
# belongs to the OTA zone (velexis-ota, 0700); the platform units cannot open it.
STORAGE_DRIVER=local
STORAGE_DIR=/var/lib/velexis/storage

# Optional error tracking; off when empty (ADR-0016).
SENTRY_DSN=
