# /etc/velexis/ota-worker.env — extra settings for velexis-ota-worker only (loaded after ota-backend.env).
# Owner root:velexis, mode 0640. The OTA API unit cannot read this file (InaccessiblePaths=).
# The worker provisions tenant schemas (CREATE SCHEMA, migrations, grants) as velexis_migrator (ADR-0004).
DATABASE_MIGRATOR_URL=postgres://velexis_migrator:@@MIGRATOR_DB_PASSWORD@@@127.0.0.1:5432/velexis
