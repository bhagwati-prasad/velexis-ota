# /etc/velexis/ota-worker.env — extra settings for velexis-ota-worker only (loaded after ota-backend.env).
# Owner root:root, mode 0600 (read by systemd, ADR-0026). The OTA API unit also hides it (InaccessiblePaths=).
# The worker provisions tenant schemas (CREATE SCHEMA, migrations, grants) as velexis_provisioner (ADR-0004):
# CREATE on the database and ownership of tenant_* schemas only, no privilege on `platform` or `reference`.
# The velexis_migrator DSN is never given to a long-running process; only velexis-deploy uses it (migrator.env).
DATABASE_PROVISIONER_URL=postgres://velexis_provisioner:@@PROVISIONER_DB_PASSWORD@@@127.0.0.1:5432/velexis
