# =====================================================================================================
# Velexis Caddyfile (Caddy 2.8) — installed as /etc/caddy/Caddyfile by deploy/scripts/deploy.sh.
# Design: docs/mvp/adr/0018-hosted-storefront-custom-domains.md, docs/mvp/architecture.md §3,
#         docs/mvp/deployment-single-vm.md §6.
#
# Hosts are the placeholders of docs/mvp/decisions.md §4. The real base domains come from the environment
# of the caddy service (/etc/velexis/caddy.env, loaded by deploy/systemd/caddy.service.d/velexis.conf):
#   PLATFORM_BASE_DOMAIN   platform.example.com  -> portal, admin.<..>, api.<..>
#   STOREFRONT_BASE_DOMAIN ota.example.com       -> admin.<..>, api.<..>, <key>.<..> storefronts
#   ACME_EMAIL, VELEXIS_EDGE_SECRET
#   VELEXIS_WAF_ENGINE     optional: the web application firewall's mode on its blocking paths (default On; see (waf))
# VELEXIS_ROOT is for the smoke test only: a prefix for the /srv/velexis folders below. It is never set on the VM,
# where it expands to nothing. VELEXIS_WAF_DIR (default /etc/caddy/waf) is where the firewall's rule files are; only
# velexis-deploy (to validate the files of a new release before they go live) and the smoke test set it.
# Every app listens on 127.0.0.1 only; Caddy is the only public process (ports 80 and 443).
# This file needs the Velexis Caddy build (Caddy 2.8.4 with the Coraza module; deploy/caddy/build/build-caddy.sh),
# installed as /usr/local/bin/caddy-velexis, which the caddy service runs as /usr/bin/caddy (provision-vm.sh, step caddy).
# Validate before installing: caddy validate --config deploy/caddy/Caddyfile --adapter caddyfile
# Test end to end (local CA, test ports, an echo upstream): bash deploy/caddy/test/caddy-smoke.sh
# =====================================================================================================
{
	# The web application firewall runs before every other handler of a site (task X-039, snippet (waf) below).
	order coraza_waf first

	email {$ACME_EMAIL:ops@example.com}
	# Admin API on a unix socket in /run/caddy (RuntimeDirectory, mode 0700, user caddy; caddy.service.d drop-in),
	# never on TCP: an app process could otherwise POST /load and rewrite the live config, for example the payment
	# page CSP. `systemctl reload caddy` reads this address from the config. Changing the address needs a restart.
	admin unix//run/caddy/admin.sock

	# On-demand TLS for storefront sub-domains and verified custom domains. Caddy asks the platform
	# backend before every new certificate; anything but 200 means "no certificate" (ADR-0018).
	on_demand_tls {
		ask http://127.0.0.1:3100/internal/tls/ask
	}

	servers {
		protocols h1 h2 h3
		# Request line and headers together (Go's default is 1MB). The apps take 16KiB at most (Node's limit), and the
		# web application firewall inspects every header, at about 7 ms of CPU per KiB (X-039, waf/coraza.conf).
		max_header_size 32KiB
		# `log_credentials` stays OFF (the default), so Cookie, Set-Cookie, Authorization and
		# Proxy-Authorization are redacted in access logs. Never enable it.
	}
}

# ---- Snippets ---------------------------------------------------------------------------------------

# Query values that never reach a log line (FIX-W29-SECURITY; deployment-single-vm.md §12). The access log deletes them
# from the request's `uri`, from its `Referer` (a page's own address with the whole query, which the browser sends with
# every same-origin request of the page: its scripts, styles and data fetches) and from a redirect's `Location`:
#   - secrets: the signature of a signed URL (`sig`), single-use tokens (`token`), and Stripe's client secrets, which
#     the 3-D Secure return puts into the storefront's /checkout/complete address (`payment_intent_client_secret`; a
#     setup intent's `setup_intent_client_secret`; `client_secret` of Stripe's older redirect flows). The ids and the
#     outcome (`payment_intent`, `setup_intent`, `redirect_status`) stay. Stripe Connect's return to the portal's
#     /connect/stripe/callback carries the single-use OAuth authorisation code (`code`) and state (`state`), PFE-024;
#   - personal data that the portal and the admin sites put into their URLs: a list's free-text search (`q`), e-mail
#     addresses (`email`, `customerEmail`), a traveller's name (`travelerLastName`), the free-text target of the
#     platform's audit log (`targetId`), and the page a sign-in returns to (`next`, which carries that page's query).
# A page that puts a new secret or personal value into its URL adds its parameter here and to caddy-smoke.sh.
(log_query_filter) {
	delete sig
	delete token
	delete client_secret
	delete payment_intent_client_secret
	delete setup_intent_client_secret
	delete code
	delete state
	delete q
	delete email
	delete customerEmail
	delete travelerLastName
	delete targetId
	delete next
}

# The access log of every site. Credential headers are deleted (Cookie, Set-Cookie and Authorization are redacted by
# Caddy itself, see the global options), and so is Next.js's router state, which the portal and the admin sites send
# with every navigation and server action: it holds the current page's query.
(access_log) {
	log {
		output stderr
		format filter {
			wrap json
			fields {
				request>headers>X-Api-Key delete
				request>headers>X-Csrf-Token delete
				request>headers>X-Booking-Token delete
				request>headers>X-Velexis-Edge delete
				request>headers>X-Velexis-Service-Key delete
				request>headers>Next-Router-State-Tree delete
				request>uri query {
					import log_query_filter
				}
				request>headers>Referer query {
					import log_query_filter
				}
				resp_headers>Location query {
					import log_query_filter
				}
			}
		}
	}
}

# Security headers. A `header` block that deletes a header (-Server) is deferred, and deferred headers are not
# applied to responses written by handle_errors: every handle_errors block below imports its headers again.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}
}

# Keep a valid client X-Request-Id, otherwise set a fresh one (ADR-0016).
(request_id) {
	@no_request_id not header_regexp X-Request-Id ^[A-Za-z0-9._-]{8,128}$
	request_header @no_request_id X-Request-Id {http.request.uuid}
}

# While an app restarts or is down, Next.js hosts show a static maintenance page (also the M0 hello-world page).
# It lives outside the release folders (installed by provision-vm.sh, refreshed by deploy.sh), so it also
# works before the first release and during a rollback.
(maintenance_page) {
	handle_errors 502 503 504 {
		import security_headers
		root * {$VELEXIS_ROOT}/srv/velexis/maintenance
		rewrite * /index.html
		header Cache-Control "no-store"
		header Retry-After "30"
		file_server {
			status 503
		}
	}
}

# While an API restarts or is down, clients get the standard error envelope (SERVICE_UNAVAILABLE).
(api_unavailable) {
	handle_errors 502 503 504 {
		import security_headers
		header Content-Type "application/json"
		header Cache-Control "no-store"
		header Retry-After "30"
		respond `{"error":{"code":"SERVICE_UNAVAILABLE","message":"The service is temporarily unavailable. Retry shortly.","status":503,"requestId":"{http.request.header.X-Request-Id}"}}` 503
	}
}

# Web application firewall (task X-039; ADR-0027 row 6.4.2; deployment-single-vm.md §6): Coraza with the OWASP Core
# Rule Set v4 at paranoia level 1, on every public host. `import waf <matcher> <mode> <body limit>`: the matcher picks
# the requests (`*` for all of a site), the mode is Coraza's SecRuleEngine:
#   - DetectionOnly on the portal, both admin hosts, the platform API and the storefront's pages: every match is
#     logged, nothing is refused;
#   - blocking on the storefront's /api/* and /checkout/* and on api.<STOREFRONT_BASE_DOMAIN>, with the mode
#     {$VELEXIS_WAF_ENGINE:On}: On refuses a request whose anomaly score reaches 5 (one critical match) with 403 (400
#     for a body that cannot be parsed), answered by (waf_refusal_json), or with a short text on the storefront's
#     pages; arguments above 128 KiB or a body above the limit get 413 (waf/coraza.conf) without a body, as Caddy's
#     own request_body limits answer. The detection week before blocking (deployment-single-vm.md §6) sets
#     VELEXIS_WAF_ENGINE=DetectionOnly in caddy.env.
# The body limit (SecRequestBodyLimit, bytes) is how much of a request body the WAF reads. The WAF runs before
# `request_body`, so Caddy's own limits apply only after it: each limit is just above the largest request_body limit of
# its requests, and on the storefront it is 256 KiB, the WAF's in-memory limit (coraza.conf), so a storefront body is
# never buffered in a temporary file and the airline-card details never reach the disk. A longer body is refused with
# 413 (rule 200006), in detection mode by Caddy's own limit.
# Each import is a WAF instance of its own (the first about 24 MB of memory, each further one about 3 MB). It loads, in
# this order, from VELEXIS_WAF_DIR (velexis-deploy installs deploy/caddy/waf/ there) and from the Core Rule Set that the
# build embeds: coraza.conf (the engine, the CRS settings), the mode, the body limit, the CRS setup and its request
# rules (REQUEST-*.conf) and correlation summary (RESPONSE-980; responses are not inspected, so the RESPONSE-950 to 959
# rules are not loaded), logdata.conf (each matched rule logs its id, its message and the variable's name, never a
# value), then removes the rules of paranoia levels 2 to 4 (paranoia level 1 skips them anyway; removing them saves
# memory) and loads exclusions.conf (each exclusion by rule id with its reason). build-caddy.sh generates logdata.conf
# for the same rule files: change both together.
# The WAF log is Caddy's log (logger http.handlers.waf, one line per matched rule) in journald: journalctl -u caddy.
(waf) {
	coraza_waf {args[0]} {
		load_owasp_crs
		directives `
		Include {$VELEXIS_WAF_DIR:/etc/caddy/waf}/coraza.conf
		SecRuleEngine {args[1]}
		SecRequestBodyLimit {args[2]}
		Include @crs-setup.conf.example
		Include @owasp_crs/REQUEST-*.conf
		Include @owasp_crs/RESPONSE-980-CORRELATION.conf
		Include {$VELEXIS_WAF_DIR:/etc/caddy/waf}/logdata.conf
		SecRuleRemoveByTag paranoia-level/2
		SecRuleRemoveByTag paranoia-level/3
		SecRuleRemoveByTag paranoia-level/4
		Include {$VELEXIS_WAF_DIR:/etc/caddy/waf}/exclusions.conf
		`
	}
}

# A request the WAF refuses, as the APIs' error envelope: 400 INVALID_REQUEST for a body that cannot be parsed or has too
# many arguments, 403 FORBIDDEN for an attack. The WAF answers before every other handler, so the request id of
# (request_id) is set here again, with its site-level matcher. Inside `handle_errors <codes>` Caddy 2.8 replaces the
# matcher of each top-level directive with the status codes, so the directives sit in a `route` of their own.
(waf_refusal_json) {
	route {
		map {err.status_code} {waf_error_code} {waf_error_message} {
			400 INVALID_REQUEST "The request body could not be read."
			default FORBIDDEN "The request was refused by the web application firewall."
		}
		request_header @no_request_id X-Request-Id {http.request.uuid}
		header Content-Type "application/json"
		header Cache-Control "no-store"
		respond `{"error":{"code":"{waf_error_code}","message":"{waf_error_message}","status":{err.status_code},"requestId":"{http.request.header.X-Request-Id}"}}` {err.status_code}
	}
}

# Shared rules for the two API hosts. Their request body limit is in each site block: the OTA API host raises it for
# one route.
(api_common) {
	import access_log
	import security_headers
	import request_id
	encode zstd gzip

	# Edge credentials are only ever set by the storefront site block below; drop any client copy.
	request_header -X-Velexis-Edge
	request_header -X-Velexis-Host

	# Internal endpoints (TLS ask, internal jobs) and readiness details are never public.
	@internal path /internal/*
	respond @internal 404
	@private_health {
		path /health/*
		not path /health/live
	}
	respond @private_health 404

	import api_unavailable
}

# Storefront headers: strict CSP (ADR-0018). Deferred like security_headers, so the 404 page imports them again.
# `worker-src 'none'`: no script of the origin can register a service worker in front of the airline-card page
# (OADR-0017 point 3). No storefront answer but that page's sends Cross-Origin-Opener-Policy: the OTA API's helmet
# adds `same-origin` to every answer, so `-Cross-Origin-Opener-Policy` removes it from the proxied /api/* answers
# (the airline-card page's own block sets it again, after this one).
(storefront_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://js.stripe.com https://*.js.stripe.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.stripe.com; frame-src https://js.stripe.com https://*.js.stripe.com https://hooks.stripe.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; worker-src 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Cross-Origin-Opener-Policy
		-Server
	}
}

# The hosted multi-tenant storefront: static files + same-origin /api proxy (ADR-0018).
(storefront) {
	import access_log
	import storefront_headers
	import request_id
	encode zstd gzip

	# The WAF blocks on the OTA API (/api/*) and the payment pages (/checkout/*) and only detects on the other pages
	# (X-039). The two matchers are each other's negation, with the path matcher of `handle /api/*` below, so every
	# request meets exactly one WAF, and a request that reaches the OTA API always meets the blocking one.
	# Both read at most 256 KiB of a body (the /api limit below is 256KB), in memory.
	@waf_blocking path /api/* /checkout/*
	import waf @waf_blocking {$VELEXIS_WAF_ENGINE:On} 262144
	@waf_detecting not path /api/* /checkout/*
	import waf @waf_detecting DetectionOnly 262144

	# The airline-card page (OADR-0017 point 3; its file and `try_files`' name for it): a CSP without any Stripe host,
	# `Cross-Origin-Opener-Policy: same-origin`, so a window that any other page of the origin opens on it gets no handle
	# on its card inputs, and `no-store`. Same-named directives with a matcher run before the storefront's header block
	# without one, and deferred header blocks apply in reverse order when the response is written: these values replace
	# the storefront CSP and the file server's `no-cache`. Error pages (handle_errors) keep the storefront headers.
	@pay_airline path /checkout/pay-airline.html /checkout/pay-airline
	header @pay_airline {
		Content-Security-Policy "default-src 'self'; script-src 'self'; connect-src 'self'; frame-src 'none'; img-src 'self' data:; style-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; worker-src 'none'"
		Cross-Origin-Opener-Policy "same-origin"
		Cache-Control "no-store"
		defer
	}

	# The OTA API's public images (/api/v1/assets/<key>/<id>.<ext>, getPublicAsset; OADR-0012 point 3, lead decision
	# (2b) of 2026-10-30) keep the API's own `Content-Security-Policy: default-src 'none'` instead of the storefront
	# CSP, so an image opened directly loads and runs nothing. The storefront's header block replaces any upstream CSP,
	# so this block sets the API's value again (PUBLIC_ASSET_CSP of ota/backend/src/storefront/public-assets.controller.ts:
	# change both together): as with @pay_airline, it sorts before the storefront's header block and applies after it.
	# The other storefront headers stay, and every other /api/* answer keeps the storefront CSP.
	@public_asset path /api/v1/assets/*
	header @public_asset {
		Content-Security-Policy "default-src 'none'"
		defer
	}

	# Internal endpoints and readiness details of the OTA API are never public, as on the API hosts. This must be
	# a handle of its own before `handle /api/*`: a plain `respond` sorts after `handle` and would never run.
	@api_private {
		path /api/internal/* /api/health/*
		not path /api/health/live
	}
	handle @api_private {
		respond 404
	}

	handle /api/* {
		request_body {
			max_size 256KB
		}
		uri strip_prefix /api
		reverse_proxy 127.0.0.1:4000 {
			# header_up REPLACES any client-supplied value, so a browser cannot forge these.
			header_up X-Velexis-Edge {env.VELEXIS_EDGE_SECRET}
			header_up X-Velexis-Host {host}
		}
	}

	handle {
		root * {$VELEXIS_ROOT}/srv/velexis/current/storefront
		# Vite puts hashed assets under /assets/; everything else (HTML) is revalidated on each load.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@not_hashed not path /assets/*
		header @not_hashed Cache-Control "no-cache"
		# The OTA's content pages (OADR-0015 point 4, OADR-0012 point 5): /p/<slug> is served by p.html, which reads the
		# slug from its address and asks the OTA API for the page (an unknown slug shows the 404 content there, with
		# noindex). `rewrite` runs before `try_files` (Caddy's directive order); the dev server and `vite preview` do the
		# same (ota/frontend/scripts/vite-plugins.js).
		rewrite /p/* /p.html
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors 404 {
		import storefront_headers
		root * {$VELEXIS_ROOT}/srv/velexis/current/storefront
		rewrite * /404.html
		file_server {
			status 404
		}
	}
	# A request the WAF refuses (X-039): the API's error envelope on /api/*, a short text on the payment pages; both with
	# the storefront headers and no-store. The `route` keeps the path matchers (see (waf_refusal_json)).
	handle_errors 400 403 {
		import storefront_headers
		route {
			handle /api/* {
				import waf_refusal_json
			}
			handle {
				header Content-Type "text/plain; charset=utf-8"
				header Cache-Control "no-store"
				respond "The request was refused by the web application firewall." {err.status_code}
			}
		}
	}
	import api_unavailable
}

# ---- Platform hosts ----------------------------------------------------------------------------------

# Portal (platform/frontend, Next.js).
{$PLATFORM_BASE_DOMAIN:platform.example.com} {
	import access_log
	import security_headers
	import request_id
	encode zstd gzip
	# The WAF reads up to 5 MiB of a body, just above the 5MB below.
	import waf * DetectionOnly 5242880
	request_body {
		max_size 5MB
	}
	reverse_proxy 127.0.0.1:3000
	import maintenance_page
}

# Platform admin (platform/admin, Next.js). MFA is mandatory in the app.
admin.{$PLATFORM_BASE_DOMAIN:platform.example.com} {
	import access_log
	import security_headers
	import request_id
	encode zstd gzip
	# Optional: allow Velexis staff networks only. Replace the documentation range and uncomment.
	# @outside_staff not remote_ip 203.0.113.0/24
	# respond @outside_staff 403
	import waf * DetectionOnly 5242880
	request_body {
		max_size 5MB
	}
	reverse_proxy 127.0.0.1:3001
	import maintenance_page
}

# Platform API (platform/backend) incl. /webhooks/stripe/billing. /internal/* is blocked by api_common.
api.{$PLATFORM_BASE_DOMAIN:platform.example.com} {
	import api_common
	import waf * DetectionOnly 1048576
	request_body {
		max_size 1MB
	}
	reverse_proxy 127.0.0.1:3100
}

# ---- OTA hosts -----------------------------------------------------------------------------------------

# OTA admin (ota/admin, Next.js). The OTA is chosen after sign-in (SSO from the portal).
admin.{$STOREFRONT_BASE_DOMAIN:ota.example.com} {
	import access_log
	import security_headers
	import request_id
	encode zstd gzip
	import waf * DetectionOnly 10485760
	request_body {
		max_size 10MB
	}
	reverse_proxy 127.0.0.1:3002
	import maintenance_page
}

# OTA API for SDK users with pk_/sk_ keys, and the Stripe payment webhooks.
api.{$STOREFRONT_BASE_DOMAIN:ota.example.com} {
	import api_common

	# The WAF blocks on every path (X-039); Stripe's signed webhook events only detect (exclusions.conf, rule 10001). It
	# reads up to 1200 KiB of a body, just above the asset upload's 1100KiB below.
	import waf * {$VELEXIS_WAF_ENGINE:On} 1228800
	handle_errors 400 403 {
		import security_headers
		import waf_refusal_json
	}

	# Request bodies up to 1MB (1,000,000 bytes), except the storefront asset upload (POST /v1/console/settings/assets,
	# consoleUploadStorefrontAsset, OADR-0012 point 2; lead decision (2c) of 2026-10-30): a file of up to 1 MiB in a
	# multipart body, which the API itself refuses above 1 MiB + 16 KiB (1,064,960 bytes: ASSET_UPLOAD_BODY_LIMIT_BYTES
	# of ota/backend/src/settings/assets.service.ts; change both together), so the edge lets up to 1100KiB (1,126,400
	# bytes) through on that route only. Two request_body directives that both match nest, and the smaller limit wins:
	# the two matchers are each other's negation, so exactly one applies to every request. The storefront's /api keeps
	# its 256KB, and the OTA admin calls the API on the loopback.
	@asset_upload {
		method POST
		path /v1/console/settings/assets
	}
	request_body @asset_upload {
		max_size 1100KiB
	}
	@not_asset_upload {
		not {
			method POST
			path /v1/console/settings/assets
		}
	}
	request_body @not_asset_upload {
		max_size 1MB
	}

	reverse_proxy 127.0.0.1:4000
}

# Storefronts on <key>.ota.example.com. Exact host names above (admin., api.) win over the wildcard.
# Certificates are issued per host name on the first handshake, only after the ask endpoint answers 200
# (one certificate per OTA; a DNS-01 wildcard certificate is the ADR-0018 follow-up).
*.{$STOREFRONT_BASE_DOMAIN:ota.example.com} {
	tls {
		on_demand
	}
	import storefront
}

# Verified custom domains (travel.example.net, ...): any other host name. Same storefront, same ask gate.
https:// {
	tls {
		on_demand
	}
	import storefront
}

# Plain HTTP for unknown hosts: redirect to HTTPS (ACME HTTP challenges are answered before this).
http:// {
	redir https://{host}{uri} 308
}
