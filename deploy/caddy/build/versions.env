# =====================================================================================================
# versions.env — the pinned inputs of the Velexis Caddy build (task X-039; docs/mvp/deployment-single-vm.md §6).
#
# build-caddy.sh reads this file (KEY=value lines only; it is never sourced) and builds Caddy with the Coraza web
# application firewall and the OWASP Core Rule Set from exactly these versions, with exactly this Go toolchain, for
# the VM's platform. The build is reproducible: the same file gives the same binary on any linux/amd64 host, and
# CADDY_SHA256 is that binary's SHA-256, which build-caddy.sh, provision-vm.sh (CADDY_BINARY) and caddy-smoke.sh check.
#
# Changing a version: change it here, run `bash deploy/caddy/build/build-caddy.sh /tmp/caddy-build` (it fails and
# prints the new SHA-256), put that value in CADDY_SHA256, run it a second time into another folder to see the same
# SHA-256, then `bash deploy/caddy/test/caddy-smoke.sh`, and say in the commit why the version changed. A new Core Rule
# Set version also needs deploy/caddy/waf/logdata.conf regenerated (build-caddy.sh says so and prints it).
# Not a secret, and not an env file of the VM: pack-release.sh keeps this one file in the release.
# =====================================================================================================

# Go toolchain: the golang.org/toolchain module zip for linux-amd64 from proxy.golang.org, and its SHA-256. The newest
# patch of Go 1.26, the older of the two Go releases with security fixes: a Caddy 2.8.4 built with Go 1.27.4 panics
# while it opens its log writers (`interface is nil, not caddy.WriterOpener`), with or without the WAF.
GO_VERSION=1.26.11
GO_TOOLCHAIN_SHA256=e1edb778de0aa08c8e827f5a873b35a46afe680fb241482c531725b2355e470d

# The build tool and the modules (fetched through proxy.golang.org, checked against sum.golang.org).
XCADDY_VERSION=v0.4.7
# Caddy 2.8.4 as since X-022; coraza-caddy v2.0.0 is the last release built for Caddy 2.8 (it requires exactly 2.8.4).
CADDY_VERSION=v2.8.4
CORAZA_CADDY_VERSION=v2.0.0
# Coraza v3.8.1, the newest v3 release, instead of the v3.3.2 that coraza-caddy v2.0.0 names: 3.3.3 fixed the
# REQUEST_FILENAME bypass of request paths that start with // (CVE-2025-29914), and before 3.8.0 the temporary file of a
# multipart body's file part could stay behind for good (in 3.3.3 for every part without its closing boundary, also a
# body cut at the WAF's body limit), so anyone could fill the VM's disk; 3.8.x removes it when the request ends
# (caddy-smoke.sh step 6e checks it). It also raises golang.org/x/net and golang.org/x/crypto in the build to current
# releases. It builds with coraza-caddy v2.0.0 and Caddy 2.8.4 unchanged.
CORAZA_VERSION=v3.8.1
# The OWASP Core Rule Set v4 embedded by coraza-coreruleset (its version is the CRS release, 4.7.0).
CORERULESET_VERSION=v4.7.0

# The VM's platform (deployment-single-vm.md §1), without cgo.
TARGET_GOOS=linux
TARGET_GOARCH=amd64
TARGET_GOAMD64=v1

# The fixed build time: the binary's modification time (Go itself embeds no time). 2026-11-11T00:00:00Z.
SOURCE_DATE_EPOCH=1794355200

# The SHA-256 of the binary these versions build.
CADDY_SHA256=32d2c91723033b5228361e60f441e350da01837cce3684b14db8c62b6a614a4c
