{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs", ".prettierrc.json"],
  "globalEnv": ["NODE_ENV", "APP_ENV", "CI"],
  "tasks": {
    "generate": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/ota/backend/openapi/**",
        "$TURBO_ROOT$/platform/backend/openapi/**"
      ],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.*", "!test/**", "!.env*"],
      "env": ["NEXT_PUBLIC_*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!.env*"],
      "outputs": ["coverage/**"]
    },
    "@velexis/api-types#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.env*",
        "$TURBO_ROOT$/ota/backend/openapi/**",
        "$TURBO_ROOT$/platform/backend/openapi/**"
      ],
      "outputs": ["coverage/**"]
    },
    "@velexis/errors#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.env*",
        "$TURBO_ROOT$/ota/backend/openapi/**",
        "$TURBO_ROOT$/platform/backend/openapi/**"
      ],
      "outputs": ["coverage/**"]
    },
    "@velexis/platform-backend#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.env*",
        "$TURBO_ROOT$/ota/backend/openapi/**",
        "$TURBO_ROOT$/platform/docs/api-inventory*.md",
        "$TURBO_ROOT$/platform/docs/scope.md",
        "$TURBO_ROOT$/platform/docs/data-model-migration-0002*.md",
        "$TURBO_ROOT$/platform/docs/flows/*.md",
        "$TURBO_ROOT$/platform/docs/plans/agent-tasks.md",
        "$TURBO_ROOT$/.env.example",
        "$TURBO_ROOT$/platform/frontend/.env.example",
        "$TURBO_ROOT$/platform/admin/.env.example",
        "$TURBO_ROOT$/deploy/env/platform-backend.env.example"
      ],
      "outputs": ["coverage/**"]
    },
    "@velexis/amadeus-stub#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.env*",
        "$TURBO_ROOT$/docs/amadeus-api/**",
        "$TURBO_ROOT$/ota/backend/openapi/**",
        "$TURBO_ROOT$/package.json"
      ],
      "outputs": ["coverage/**"]
    },
    "@velexis/testing#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.env*",
        "$TURBO_ROOT$/ota/backend/openapi/**",
        "$TURBO_ROOT$/platform/backend/openapi/**",
        "$TURBO_ROOT$/packages/api-types/redocly.yaml",
        "$TURBO_ROOT$/deploy/postgres/*.sql",
        "$TURBO_ROOT$/.env.example",
        "$TURBO_ROOT$/ota/backend/.env.example",
        "$TURBO_ROOT$/platform/backend/.env.example",
        "$TURBO_ROOT$/platform/backend/migrations/**",
        "$TURBO_ROOT$/ota/backend/migrations/**",
        "$TURBO_ROOT$/docs/mvp/architecture.md"
      ],
      "outputs": ["coverage/**"]
    },
    "@velexis/e2e#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.env*",
        "$TURBO_ROOT$/.github/workflows/e2e.yml",
        "$TURBO_ROOT$/.env.example",
        "$TURBO_ROOT$/platform/backend/.env.example",
        "$TURBO_ROOT$/platform/frontend/.env.example",
        "$TURBO_ROOT$/platform/admin/.env.example",
        "$TURBO_ROOT$/ota/backend/.env.example"
      ],
      "outputs": ["coverage/**"]
    },
    "@velexis/platform-admin#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.env.example",
        "$TURBO_ROOT$/platform/frontend/.env.example",
        "$TURBO_ROOT$/deploy/env/platform-admin.env.example",
        "$TURBO_ROOT$/deploy/systemd/velexis-platform-admin.service",
        "$TURBO_ROOT$/platform/backend/openapi/**",
        "$TURBO_ROOT$/platform/backend/src/audit/audit-actions.ts"
      ],
      "outputs": ["coverage/**"]
    },
    "test:int": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_MIGRATOR_URL",
        "DATABASE_PROVISIONER_URL",
        "TEST_DATABASE_ADMIN_URL",
        "REDIS_URL",
        "SMTP_URL",
        "MAILPIT_API_URL",
        "AMADEUS_BASE_URL_TEST",
        "STRIPE_*",
        "VELEXIS_*"
      ]
    },
    "contracts:lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/ota/backend/openapi/**",
        "$TURBO_ROOT$/platform/backend/openapi/**"
      ],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "clean": {
      "cache": false
    }
  }
}
